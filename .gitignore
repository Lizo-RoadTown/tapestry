__pycache__/
*.pyc
.pytest_cache/
.venv/
.env
.env.local
*.env
!.env.example

# Per-machine Claude Code state
.claude/logs/
.claude/settings.local.json

# MCP config — may contain API tokens; per-machine, not committed
.mcp.json

# Architecture snapshots — auto-generated by the loom-discipline plugin's
# SessionStart hook (and the on-demand /architecture-report command).
# Tracked in git as of 2026-11-05 (operator decision) so snapshots, diffs,
# and narratives sync across machines instead of staying local-per-machine.
# This commits a record of each session's architecture state to history.
services/docs-mcp/docs_mcp/_corpus/
services/docs-mcp/*.egg-info/
services/docs-mcp/build/
services/docs-mcp/dist/
*.egg-info/

# Playwright MCP screenshot/console dumps
.playwright-mcp/

# Redundant brand-sheet archive (extracted contents are committed)
docs/assets/*.zip
