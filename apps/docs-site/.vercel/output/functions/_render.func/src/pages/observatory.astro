---
export const prerender = false;
/**
 * The Observatory — an interactive variable-overlay cockpit.
 * Telemetry is modeled as selectable variables over time; pick a variable and an
 * overlay and the observer explains what the view can expose. Variable-driven,
 * not card-driven. Honest: blind variables (friction/memory/corrections) are
 * selectable but plotted as "not instrumented", never faked.
 */
const CANON = "https://github.com/Lizo-RoadTown/tapestry/blob/main/docs/canon/user-agent-coordination-reinforcement.md";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Observatory — Tapestry</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href="/">Tapestry</a>
      <nav class="topnav"><a href="/">Home</a><a href="/docs/">Docs</a><a class="here" href="/observatory">Observatory</a><a href="/observatory/raw">Raw events</a></nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow mono" id="src">pattern cockpit · loading…</p>
        <h1 class="display">The <span class="ac">Observatory</span></h1>
        <p class="lede">Choose variables, overlay them, and let the observer explain what patterns the view can expose.</p>
      </section>

      <section class="controls">
        <label>Show <select id="y"></select></label>
        <label>over <span class="mono">time</span></label>
        <label>overlaid with <select id="overlay"></select></label>
        <label>as <select id="ctype"><option value="line">trend (line)</option><option value="scatter">relationship (scatter)</option></select></label>
        <span class="rec mono" id="rec"></span>
      </section>

      <section class="chartwrap"><div id="chart" class="chart"><p class="loading mono">loading…</p></div><div id="legend" class="legend"></div></section>

      <section class="interp" id="interp"></section>

      <footer class="foot"><p class="mono">Raw counters + events: <a href="/observatory/raw">Raw events (debug)</a>. Canon: <a href={CANON}>user-agent-coordination-reinforcement</a>.</p></footer>
    </main>

    <script>
      type V = { id: string; label: string; lens: string; kind: "real" | "blind"; unit: string; series: (number | null)[] };
      const esc = (s: any) => String(s).replace(/[&<>]/g, (c: string) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]!));
      const LABEL: Record<string, string> = { arch_changes: "architecture changes", episodes: "working episodes", tool_activity: "tool activity", observer_candidates: "observer candidates", friction: "friction recurrence", memory_miss: "memory misses", corrections: "correction frequency" };
      const CURATED: Record<string, { why: string; patterns: string[] }> = {
        "arch_changes+friction": { why: "Tests whether project-shape changes are followed by coordination friction.", patterns: ["architecture churn causing coordination degradation", "friction dropping after durable structure forms"] },
        "friction+memory_miss": { why: "Tests whether missing memory increases repeated correction / friction.", patterns: ["memory misses preceding friction spikes", "friction dampened when memory recall succeeds"] },
        "arch_changes+memory_miss": { why: "Tests whether structural changes are followed by memory misses — the system forgetting what just changed.", patterns: ["memory misses following structural changes", "observer confidence lagging behind project changes"] },
        "episodes+observer_candidates": { why: "Tests whether more working activity yields more durable structure.", patterns: ["durable structure forming after sustained work", "candidate rate flat despite activity (loop not closing)"] },
      };

      let DAYS: string[] = [], VARS: V[] = [];
      const v = (id: string) => VARS.find((x) => x.id === id)!;

      function interpret(yId: string, oId: string | null) {
        const y = v(yId), o = oId ? v(oId) : null;
        const blind = [y, o].filter((x) => x && x.kind === "blind").map((x) => x!.label);
        const key = [yId, oId].filter(Boolean).sort().join("+");
        const c = CURATED[key];
        const looking = o ? `${LABEL[yId]} over time, overlaid with ${LABEL[oId!]}` : `${LABEL[yId]} over time`;
        const why = c?.why || (o ? `Tests whether ${LABEL[yId]} and ${LABEL[oId!]} move together over time.` : `Shows how ${LABEL[yId]} is trending.`);
        const patterns = c?.patterns || (o ? [`${LABEL[yId]} rising/falling with ${LABEL[oId!]}`, "no relationship — the two move independently"] : [`${LABEL[yId]} increasing or decreasing over time`]);
        const finding = blind.length === 2 ? "Neither variable is instrumented yet — this relationship cannot be measured. Shown so you can see what's missing." : blind.length === 1 ? `${blind[0]} isn't instrumented yet, so the relationship can't be measured; the other variable is real and plotted.` : "Both variables are real and plotted. The observer doesn't yet interpret the relationship — that needs transcript-derived signals.";
        return { looking, why, patterns, finding, blind };
      }

      function line(series: (number | null)[], color: string, dashed: boolean) {
        const W = 620, H = 200, P = 24;
        const real = series.map((s, i) => [i, s] as [number, number | null]).filter(([, s]) => s != null) as [number, number][];
        if (!real.length) return `<line x1="${P}" y1="${H / 2}" x2="${W - P}" y2="${H / 2}" stroke="${color}" stroke-width="2" stroke-dasharray="5 6" opacity="0.5"/>`;
        const max = Math.max(1, ...real.map(([, s]) => s));
        const n = Math.max(1, series.length - 1);
        const pt = (i: number, s: number) => [P + (i / n) * (W - 2 * P), H - P - (s / max) * (H - 2 * P)];
        const d = real.map(([i, s], k) => `${k ? "L" : "M"}${pt(i, s).map((x) => x.toFixed(1)).join(" ")}`).join(" ");
        const dots = real.map(([i, s]) => { const [x, y] = pt(i, s); return `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="3" fill="${color}"/>`; }).join("");
        return `<path d="${d}" fill="none" stroke="${color}" stroke-width="2" ${dashed ? 'stroke-dasharray="5 6"' : ""}/>${dots}`;
      }

      function render() {
        const yId = (document.getElementById("y") as HTMLSelectElement).value;
        const oId = (document.getElementById("overlay") as HTMLSelectElement).value || null;
        const y = v(yId), o = oId ? v(oId) : null;
        const ctype = (document.getElementById("ctype") as HTMLSelectElement).value;
        const bothReal = !!o && y.kind === "real" && o.kind === "real";
        (document.getElementById("rec") as HTMLElement).textContent = o ? (bothReal ? "↳ scatter shows the relationship" : "↳ line (one variable isn't instrumented)") : "↳ line (single trend over time)";
        const W = 620, H = 200, P = 24;
        const chart = document.getElementById("chart") as HTMLElement;
        const tag = (vv: V, col: string) => `<span class="lg"><span class="sw" style="background:${col}"></span>${esc(vv.label)} <span class="u mono">${esc(vv.unit)}</span>${vv.kind === "blind" ? '<span class="bl">⊘ not instrumented</span>' : ""}</span>`;

        if (ctype === "scatter" && o) {
          // relationship: x = overlay variable, y = main variable, one point per day
          if (!bothReal) {
            const missing = y.kind === "blind" ? y : o!;
            chart.innerHTML = `<div class="cant"><span class="g mono">⊘</span><p>Can't plot a relationship — <b>${esc(missing.label)}</b> isn't instrumented yet, so one axis has no data. This is where the relationship will appear once it's wired.</p></div>`;
            (document.getElementById("legend") as HTMLElement).innerHTML = "";
          } else {
            const SP = 30;
            const pts = DAYS.map((_, i) => [o.series[i], y.series[i]]).filter(([a, b]) => a != null && b != null) as [number, number][];
            const xmax = Math.max(1, ...pts.map((p) => p[0])), ymax = Math.max(1, ...pts.map((p) => p[1]));
            const px = (x: number, yy: number) => [SP + (x / xmax) * (W - 2 * SP), H - SP - (yy / ymax) * (H - 2 * SP)];
            const dots = pts.map(([a, b]) => { const [X, Y] = px(a, b); return `<circle cx="${X.toFixed(1)}" cy="${Y.toFixed(1)}" r="4" fill="#5fd3da" opacity="0.85"/>`; }).join("");
            const axis = `<line x1="${SP}" y1="${H - SP}" x2="${W - SP}" y2="${H - SP}" stroke="#2a2f31"/><line x1="${SP}" y1="${SP}" x2="${SP}" y2="${H - SP}" stroke="#2a2f31"/>`;
            const ax = `<text x="${W / 2}" y="${H - 4}" fill="#8b9492" font-size="10" text-anchor="middle">${esc(o.label)} →</text><text x="4" y="${SP - 10}" fill="#8b9492" font-size="10">↑ ${esc(y.label)}</text>`;
            chart.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="100%">${axis}${ax}${dots}</svg>`;
            (document.getElementById("legend") as HTMLElement).innerHTML = `<span class="lg">each point = one day · ${esc(o.label)} vs ${esc(y.label)}</span>`;
          }
        } else {
          const axis = `<line x1="${P}" y1="${H - P}" x2="${W - P}" y2="${H - P}" stroke="#2a2f31"/><line x1="${P}" y1="${P}" x2="${P}" y2="${H - P}" stroke="#2a2f31"/>`;
          const labels = DAYS.map((d, i) => { const x = P + (i / Math.max(1, DAYS.length - 1)) * (W - 2 * P); return `<text x="${x.toFixed(1)}" y="${H - 6}" fill="#8b9492" font-size="9" text-anchor="middle" font-family="monospace">${esc(d.slice(5))}</text>`; }).join("");
          chart.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="100%">${axis}${labels}${line(y.series, "#5fd3da", y.kind === "blind")}${o ? line(o.series, "#d8b06a", o.kind === "blind") : ""}</svg>`;
          (document.getElementById("legend") as HTMLElement).innerHTML = tag(y, "#5fd3da") + (o ? tag(o, "#d8b06a") : "");
        }

        const it = interpret(yId, oId);
        (document.getElementById("interp") as HTMLElement).innerHTML = `
          <div class="ic"><div class="ih">What you're looking at</div><p>${esc(it.looking)}</p></div>
          <div class="ic"><div class="ih">Why these matter together</div><p>${esc(it.why)}</p></div>
          <div class="ic"><div class="ih">Patterns this view may expose</div><ul>${it.patterns.map((p) => `<li>${esc(p)}</li>`).join("")}</ul></div>
          <div class="ic finding"><div class="ih">What the observer currently thinks</div><p>${esc(it.finding)}</p></div>
          ${it.blind.length ? `<div class="ic blind"><div class="ih">Blind / low-confidence</div><p>${it.blind.map(esc).join(" · ")} — not instrumented yet.</p></div>` : ""}`;
      }

      async function load() {
        const d = await (await fetch("/api/episodes.json", { cache: "no-store" })).json();
        const sl: Record<string, string> = { "live:central-store": "live", "dev:hooks.jsonl": "live · this machine", "snapshot:events-sample": "real snapshot" };
        (document.getElementById("src") as HTMLElement).textContent = "pattern cockpit · " + (sl[d.source] || d.source);
        DAYS = d.cockpit.days; VARS = d.cockpit.variables;
        const pickable = VARS.filter((x: V) => x.id !== "time");
        const opt = (x: V) => `<option value="${x.id}">${esc(x.label)}${x.kind === "blind" ? " ⊘" : ""}</option>`;
        (document.getElementById("y") as HTMLElement).innerHTML = pickable.map(opt).join("");
        (document.getElementById("overlay") as HTMLElement).innerHTML = `<option value="">— none —</option>` + pickable.map(opt).join("");
        (document.getElementById("y") as HTMLSelectElement).value = "arch_changes";
        (document.getElementById("overlay") as HTMLSelectElement).value = "friction";
        document.getElementById("y")!.addEventListener("change", render);
        document.getElementById("overlay")!.addEventListener("change", render);
        document.getElementById("ctype")!.addEventListener("change", render);
        render();
      }
      load().catch((e) => { (document.getElementById("chart") as HTMLElement).innerHTML = '<p class="loading mono">feed error: ' + esc(e) + "</p>"; });
    </script>

    <style is:global>
      :root{color-scheme:dark;--surface:#0a0d0e;--raised:#16191b;--edge:#2a2f31;--ink:#f3f5f4;--dim:#c4ccca;--faint:#8b9492;--brand:#5fd3da;--warn:#d8b06a;--font-d:"Instrument Serif",Georgia,serif;--font-s:"Inter",system-ui,sans-serif;--font-m:"JetBrains Mono",ui-monospace,Consolas,monospace}
      *{box-sizing:border-box}html,body{height:100%}
      body{margin:0;font:16px/1.55 var(--font-s);color:var(--ink);background:radial-gradient(120% 80% at 50% 120%,#5fd3da12 0,transparent 60%),var(--surface);background-attachment:fixed;-webkit-font-smoothing:antialiased}
      a{color:inherit}.mono{font-family:var(--font-m);font-variant-numeric:tabular-nums}.display{font-family:var(--font-d);font-weight:400}.ac{font-family:var(--font-d);font-style:italic;color:var(--brand)}
      .topbar{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid var(--edge);position:sticky;top:0;z-index:10;background:#0a0d0ecc;backdrop-filter:blur(8px)}
      .wordmark{font-family:var(--font-d);font-size:20px;text-decoration:none}.topnav{display:flex;gap:18px;font-size:14px}.topnav a{color:var(--faint);text-decoration:none}.topnav a:hover{color:var(--ink)}.topnav .here{color:var(--ink);border-bottom:2px solid var(--brand)}
      main{max-width:760px;margin:0 auto;padding:40px 24px 90px}section{margin-bottom:28px}
      .eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);margin:0 0 6px}
      .hero h1{font-size:clamp(38px,7vw,58px);margin:0 0 10px;line-height:1.03}.lede{font-size:18px;color:var(--dim);max-width:60ch;margin:0}.hero{margin-bottom:32px}
      .controls{display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;padding:14px 16px;border:1px solid var(--edge);border-radius:13px;background:var(--raised);font-size:14px;color:var(--dim)}
      .controls label{display:inline-flex;align-items:center;gap:7px}
      select{background:var(--surface);color:var(--ink);border:1px solid var(--edge);border-radius:8px;padding:6px 9px;font:13px var(--font-s);cursor:pointer}
      .chartwrap{border:1px solid var(--edge);border-radius:14px;padding:16px;background:color-mix(in srgb,var(--raised) 45%,transparent)}
      .chart svg{display:block}.loading{color:var(--faint);font-size:13px}
      .rec{font-size:12px;color:var(--brand);white-space:nowrap}
      .cant{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:170px;text-align:center;padding:0 24px}
      .cant .g{font-size:22px;color:var(--warn)}.cant p{margin:0;font-size:14px;color:var(--dim);max-width:54ch}.cant b{color:var(--ink);font-weight:500}
      .legend{display:flex;flex-wrap:wrap;gap:16px;margin-top:10px;font-size:12px;color:var(--dim)}
      .lg{display:inline-flex;align-items:center;gap:6px}.sw{width:14px;height:3px;border-radius:2px;display:inline-block}.u{color:var(--faint);font-size:11px}.bl{color:var(--warn);font-size:11px;margin-left:4px}
      .interp{display:grid;gap:12px}
      .ic{border:1px solid var(--edge);border-radius:12px;padding:13px 15px;background:color-mix(in srgb,var(--raised) 40%,transparent)}
      .ic .ih{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--faint);margin-bottom:6px}
      .ic p{margin:0;font-size:15px;color:var(--ink);line-height:1.5}.ic ul{margin:0;padding-left:18px}.ic li{font-size:14px;color:var(--dim);margin:3px 0}
      .ic.finding{border-left:3px solid var(--brand)}.ic.blind{border-left:3px solid var(--warn);border-style:solid}.ic.blind p{color:var(--dim)}
      .foot{margin-top:30px}.foot p{font-size:12px;color:var(--faint)}.foot a{color:var(--dim)}
    </style>
  </body>
</html>
