---
/**
 * Shared site chrome — head, fonts, nav mega-menu, footer, and the
 * reveal/menu scripts. Pages provide their own <slot> content + page-scoped
 * <style>. The design system is imported globally from site.css so the
 * nav/footer here AND each page's slotted content share the same classes.
 *
 * Props: title, description, activeNav ("platform" | "learn" | "docs").
 */
import "../styles/site.css";

const { title, description, activeNav } = Astro.props as {
  title: string;
  description: string;
  activeNav?: "platform" | "learn" | "docs";
};

const GITHUB = "https://github.com/Lizo-RoadTown/tapestry";
const DOCS = "/docs/";
const OBSERVATORY = "/observatory";
const SETUP = "/how-to/set-up-a-new-project/";

// Lead with outcomes; mechanisms are the second column (supporting evidence).
const PLATFORM_MENU = [
  {
    heading: "Platform",
    items: [
      { title: "Project intelligence", desc: "Accumulate capability instead of rebuilding context", href: "/project-intelligence", icon: `<path d="M12 2a9 9 0 1 0 9 9"/><path d="M12 7v5l3 2"/><path d="M16 3l5 2-2 5"/>` },
      { title: "How it works", desc: "Activity becomes durable intelligence", href: "/how-it-works", icon: `<path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M2 14l10 5 10-5"/>` },
      { title: "Why projects compound", desc: "Recurring friction becomes durable structure", href: "/project-shape", icon: `<path d="M3 12h4l3 8 4-16 3 8h4"/>` },
    ],
  },
  {
    heading: "Mechanisms",
    items: [
      { title: "Observatory", desc: "The live pattern console", href: OBSERVATORY, icon: `<circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/>` },
      { title: "Observer", desc: "Patterns surfaced from what happens", href: "/systems/observer/", icon: `<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3"/>` },
      { title: "Memory", desc: "Knowledge that carries across projects", href: "/systems/memory/", icon: `<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>` },
      { title: "Upskilling", desc: "Repeated work becomes reusable skills", href: "/systems/registry/", icon: `<path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M2 14l10 5 10-5"/>` },
    ],
  },
];
const LEARN_MENU = [
  { title: "What Tapestry is", href: "/start/what-stays-on-track/" },
  { title: "The observer", href: "/explanation/the-observer/" },
  { title: "The Observatory", href: "/observatory/about/" },
  { title: "What Tapestry is not", href: "/start/what-tapestry-is-not/" },
];

// Brand logomark — the recursive-loop emblem (Work / Observe / Discover / Reuse
// around a glowing core). Inlined so nav + footer share one source.
const MARK = `<svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="28" stroke="#5fd3da" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="2 4.5"/><circle cx="51.8" cy="12.2" r="1.3" fill="#9be8ec"/><circle cx="12.2" cy="51.8" r="1.3" fill="#9be8ec"/><g stroke="#5fd3da" stroke-width="1.6"><rect x="11" y="11" width="42" height="42" rx="10" transform="rotate(45 32 32)"/><rect x="16.5" y="16.5" width="31" height="31" rx="8" transform="rotate(45 32 32)" stroke-opacity="0.85"/><rect x="22" y="22" width="20" height="20" rx="5.5" transform="rotate(45 32 32)" stroke-opacity="0.7"/></g><g fill="#5fd3da"><circle cx="32" cy="3.8" r="2"/><circle cx="60.2" cy="32" r="2"/><circle cx="32" cy="60.2" r="2"/><circle cx="3.8" cy="32" r="2"/></g><circle cx="32" cy="32" r="8" fill="#5fd3da" opacity="0.16"/><circle cx="32" cy="32" r="4.4" fill="none" stroke="#5fd3da" stroke-width="1.2"/><circle cx="32" cy="32" r="2.4" fill="#5fd3da"/><circle cx="32" cy="32" r="1" fill="#dffafb"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <div class="nav-in">
        <a class="brand" href="/" aria-label="Tapestry — home"><span class="brand-mark" set:html={MARK} /><span class="wordmark">Tapestry</span></a>
        <nav class="links" aria-label="Primary">
          <div class="menu" data-menu>
            <button class="menu-trigger" aria-haspopup="true" aria-expanded="false">Platform <span class="caret" aria-hidden="true">▾</span></button>
            <div class="menu-panel mega" role="menu">
              {PLATFORM_MENU.map((group) => (
                <div class="mega-col">
                  <p class="mega-h mono">{group.heading}</p>
                  {group.items.map((it) => (
                    <a class="mega-item" role="menuitem" href={it.href}>
                      <span class="mega-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={it.icon} /></span>
                      <span class="mega-txt"><span class="mega-t">{it.title}</span><span class="mega-d">{it.desc}</span></span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
          <div class="menu" data-menu>
            <button class="menu-trigger" aria-haspopup="true" aria-expanded="false">Learn <span class="caret" aria-hidden="true">▾</span></button>
            <div class="menu-panel list" role="menu">
              {LEARN_MENU.map((it) => (<a class="list-item" role="menuitem" href={it.href}>{it.title}</a>))}
            </div>
          </div>
          <a class="navlink" href="/use-cases">Use cases</a>
          <a class="navlink" href="/open-source">Open source</a>
          <a class="navlink" href={DOCS} aria-current={activeNav === "docs" ? "page" : undefined}>Docs</a>
          <a href={GITHUB} class="gh" aria-label="GitHub repository">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5A12 12 0 0 0 8.2 23.9c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.6 18 4.9 18 4.9c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>
          </a>
        </nav>
        <a class="btn btn-sm nav-cta" href={SETUP}>Get started</a>
        <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>
          <svg class="ic-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="ic-close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </div>
    </header>

    <!-- Mobile menu lives OUTSIDE <header>: the header's backdrop-filter would
         otherwise make it the containing block for this position:fixed panel,
         collapsing it to the header's height. As a body-level element it
         resolves against the viewport and fills the screen. -->
    <div class="mobile-nav" id="mobile-nav" data-mobile-nav>
      <a class="mobile-home" href="/">Home</a>
      <p class="mobile-h mono">Platform</p>
      {PLATFORM_MENU.flatMap((g) => g.items).map((it) => (<a class="mobile-link" href={it.href}>{it.title}</a>))}
      <p class="mobile-h mono">Learn</p>
      {LEARN_MENU.map((it) => (<a class="mobile-link" href={it.href}>{it.title}</a>))}
      <p class="mobile-h mono">More</p>
      <a class="mobile-link" href="/use-cases">Use cases</a>
      <a class="mobile-link" href="/open-source">Open source</a>
      <a class="mobile-link" href="/enterprise">Enterprise</a>
      <a class="mobile-link" href={DOCS}>Docs</a>
      <a class="mobile-link" href={GITHUB}>GitHub</a>
      <a class="btn mobile-cta" href={SETUP}>Get started</a>
    </div>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="foot-in">
        <div class="foot-brand">
          <a class="brand" href="/" aria-label="Tapestry — home"><span class="brand-mark" set:html={MARK} /><span class="wordmark">Tapestry</span></a>
          <p class="foot-tag">Agentic Recursive Project Intelligence. Recursive skills that get bigger, better, and more structural over time.</p>
        </div>
        <div class="foot-cols">
          <div class="foot-col"><p class="foot-h mono">Platform</p><a href="/project-intelligence">Project intelligence</a><a href="/how-it-works">How it works</a><a href="/project-shape">Project shape</a><a href={OBSERVATORY}>Observatory</a></div>
          <div class="foot-col"><p class="foot-h mono">Explore</p><a href="/use-cases">Use cases</a><a href="/open-source">Open source</a><a href="/enterprise">Enterprise</a></div>
          <div class="foot-col"><p class="foot-h mono">Docs</p><a href={DOCS}>Documentation</a><a href={SETUP}>Quickstart</a><a href="/start/what-stays-on-track/">Concepts</a></div>
          <div class="foot-col"><p class="foot-h mono">Community</p><a href={GITHUB}>GitHub</a><a href="/explanation/discipline-stack/">Discipline stack</a></div>
        </div>
      </div>
      <p class="foot-fine mono">Tapestry · Agentic Recursive Project Intelligence</p>
    </footer>

    <script>
      const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
      if (rm || !("IntersectionObserver" in window)) {
        els.forEach((e) => e.classList.add("in"));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { (en.target as HTMLElement).classList.add("in"); io.unobserve(en.target); } });
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.08 });
        els.forEach((e) => io.observe(e));
      }

      const menus = Array.from(document.querySelectorAll<HTMLElement>("[data-menu]"));
      const closeAll = (except?: HTMLElement) => {
        menus.forEach((m) => {
          if (m === except) return;
          m.classList.remove("open");
          m.querySelector(".menu-trigger")?.setAttribute("aria-expanded", "false");
        });
      };
      menus.forEach((m) => {
        const trigger = m.querySelector<HTMLButtonElement>(".menu-trigger")!;
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          const open = m.classList.toggle("open");
          trigger.setAttribute("aria-expanded", String(open));
          closeAll(m);
        });
        m.addEventListener("mouseenter", () => trigger.setAttribute("aria-expanded", "true"));
        m.addEventListener("mouseleave", () => { if (!m.classList.contains("open")) trigger.setAttribute("aria-expanded", "false"); });
      });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeAll(); });
      document.addEventListener("click", (e) => { if (!(e.target as Element).closest("[data-menu]")) closeAll(); });

      // Mobile menu (hamburger) — full nav on small screens so no page is a dead end.
      const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");
      if (toggle && mobileNav) {
        const setOpen = (open: boolean) => {
          mobileNav.classList.toggle("open", open);
          toggle.setAttribute("aria-expanded", String(open));
          toggle.classList.toggle("is-open", open);
          document.body.classList.toggle("nav-locked", open);
        };
        toggle.addEventListener("click", () => setOpen(!mobileNav.classList.contains("open")));
        mobileNav.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
        window.addEventListener("resize", () => { if (window.innerWidth > 620) setOpen(false); });
      }
    </script>
  </body>
</html>
