    <script>
      const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
      if (rm || !("IntersectionObserver" in window)) {
        els.forEach((e) => e.classList.add("in"));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { (en.target as HTMLElement).classList.add("in"); io.unobserve(en.target); } });
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.08 });
        els.forEach((e) => io.observe(e));
      }

      // Mega-menu: hover handled by CSS; this adds click/touch + keyboard a11y.
      const menus = Array.from(document.querySelectorAll<HTMLElement>("[data-menu]"));
      const closeAll = (except?: HTMLElement) => {
        menus.forEach((m) => {
          if (m === except) return;
          m.classList.remove("open");
          m.querySelector(".menu-trigger")?.setAttribute("aria-expanded", "false");
        });
      };
      menus.forEach((m) => {
        const trigger = m.querySelector<HTMLButtonElement>(".menu-trigger")!;
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          const open = m.classList.toggle("open");
          trigger.setAttribute("aria-expanded", String(open));
          closeAll(m);
        });
        m.addEventListener("mouseenter", () => trigger.setAttribute("aria-expanded", "true"));
        m.addEventListener("mouseleave", () => { if (!m.classList.contains("open")) trigger.setAttribute("aria-expanded", "false"); });
      });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeAll(); });
      document.addEventListener("click", (e) => { if (!(e.target as Element).closest("[data-menu]")) closeAll(); });
    </script>

    <style>
      :root {
        color-scheme: dark;
        --surface: #0a0d0e; --surface-2: #0d1113; --raised: #14191b;
        --edge: #232a2c; --edge-soft: #1a2022;
        --ink: #f3f5f4; --dim: #c4ccca; --faint: #8b9492;
        --brand: #5fd3da; --warn: #d8b06a;
        --font-d: "Instrument Serif", Georgia, serif;
        --font-s: "Inter", system-ui, sans-serif;
        --font-m: "JetBrains Mono", ui-monospace, Consolas, monospace;
        --maxw: 1120px; --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font: 16px/1.6 var(--font-s); color: var(--ink); background: var(--surface); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
      a { color: inherit; text-decoration: none; }
      .mono { font-family: var(--font-m); font-variant-numeric: tabular-nums; }
      .display { font-family: var(--font-d); font-weight: 400; letter-spacing: 0.01em; }
      .accent { font-family: var(--font-d); font-style: italic; background: linear-gradient(120deg, var(--brand), #9be8ec); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .kicker { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brand); margin: 0 0 14px; }

      .reveal { opacity: 0; transform: translateY(16px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
      .reveal.in { opacity: 1; transform: none; }

      .btn { display: inline-flex; align-items: center; gap: 8px; font: 500 14px var(--font-s); padding: 10px 18px; border-radius: 10px; background: var(--brand); color: #04211f; border: 1px solid transparent; cursor: pointer; transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease), background 0.18s; white-space: nowrap; }
      .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px -8px #5fd3da66; background: #74dde3; }
      .btn-lg { font-size: 15px; padding: 13px 24px; border-radius: 12px; }
      .btn-sm { padding: 8px 15px; font-size: 13px; }
      .btn-ghost { background: transparent; color: var(--ink); border: 1px solid var(--edge); }
      .btn-ghost:hover { background: #ffffff0a; border-color: var(--brand); box-shadow: none; }

      /* nav */
      .nav { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--edge-soft); background: #0a0d0ecc; backdrop-filter: blur(12px); }
      .nav-in { max-width: var(--maxw); margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; gap: 28px; }
      .wordmark { font-family: var(--font-d); font-size: 22px; letter-spacing: 0.01em; }
      .links { display: flex; align-items: center; gap: 8px; margin-left: auto; font-size: 14px; }
      .navlink { color: var(--faint); transition: color 0.15s; padding: 8px 10px; }
      .navlink:hover { color: var(--ink); }
      .links .gh { display: inline-flex; color: var(--faint); padding: 8px 10px; transition: color 0.15s; }
      .links .gh:hover { color: var(--ink); }

      /* mega-menu */
      .menu { position: relative; }
      .menu-trigger { display: inline-flex; align-items: center; gap: 5px; font: 500 14px var(--font-s); color: var(--faint); background: none; border: 0; padding: 8px 10px; cursor: pointer; transition: color 0.15s; }
      .menu-trigger:hover, .menu:hover .menu-trigger, .menu.open .menu-trigger { color: var(--ink); }
      .caret { font-size: 9px; transition: transform 0.2s var(--ease); }
      .menu:hover .caret, .menu.open .caret { transform: rotate(180deg); }
      .menu-panel { position: absolute; top: calc(100% + 12px); left: 0; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s; border: 1px solid var(--edge); border-radius: 16px; background: #0d1214f2; backdrop-filter: blur(16px); box-shadow: 0 30px 70px -30px #000, 0 0 0 1px #00000040; padding: 18px; z-index: 60; }
      .menu-panel::before { content: ""; position: absolute; top: -12px; left: 0; right: 0; height: 12px; }
      .menu:hover .menu-panel, .menu:focus-within .menu-panel, .menu.open .menu-panel { opacity: 1; visibility: visible; transform: translateY(0); }
      .menu-panel.mega { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; width: 560px; }
      .menu-panel.list { width: 320px; display: flex; flex-direction: column; gap: 2px; }
      .mega-h { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); margin: 4px 8px 8px; }
      .mega-item { display: flex; gap: 12px; align-items: flex-start; padding: 9px 10px; border-radius: 10px; transition: background 0.15s; }
      .mega-item:hover { background: #ffffff0a; }
      .mega-ic { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 9px; color: var(--brand); background: #5fd3da12; border: 1px solid #5fd3da26; }
      .mega-txt { display: flex; flex-direction: column; gap: 2px; }
