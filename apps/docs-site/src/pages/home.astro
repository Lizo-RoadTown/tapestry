      .cta-glow { position: absolute; inset: auto 0 -40% 0; height: 560px; background: radial-gradient(55% 70% at 50% 100%, #5fd3da22 0, transparent 70%); pointer-events: none; }
      .cta-title { position: relative; font-size: clamp(34px, 6vw, 68px); line-height: 1.07; margin: 0 0 34px; }

      /* footer */
      .footer { border-top: 1px solid var(--edge-soft); padding: 60px 24px 40px; background: var(--surface-2); }
      .foot-in { max-width: var(--maxw); margin: 0 auto; display: flex; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
      .foot-brand .wordmark { font-size: 24px; margin: 0 0 8px; }
      .foot-tag { font-size: 14px; color: var(--faint); max-width: 34ch; margin: 0; line-height: 1.5; }
      .foot-cols { display: flex; gap: 48px; flex-wrap: wrap; }
      .foot-col { display: flex; flex-direction: column; gap: 11px; }
      .foot-h { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); margin: 0 0 3px; }
      .foot-col a { font-size: 14px; color: var(--dim); transition: color 0.15s; }
      .foot-col a:hover { color: var(--brand); }
      .foot-fine { max-width: var(--maxw); margin: 40px auto 0; font-size: 11.5px; color: var(--faint); border-top: 1px solid var(--edge-soft); padding-top: 22px; }

      /* responsive */
      @media (max-width: 980px) {
        .cards { grid-template-columns: 1fr; }
        .oss-grid { grid-template-columns: 1fr; }
        .segs { grid-template-columns: repeat(2, 1fr); }
        .evidence, .quickstart { grid-template-columns: 1fr; gap: 36px; }
      }
      @media (max-width: 620px) {
        .links .menu, .navlink { display: none; }
        .pains { grid-template-columns: 1fr; }
        .segs { grid-template-columns: 1fr; }
        .nav-in { gap: 14px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        html { scroll-behavior: auto; }
        .orbit, .flow, .pulse { animation: none; }
      }
    </style>
