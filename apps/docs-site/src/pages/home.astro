---
/**
 * Tapestry — marketing front page.
 *
 * Standalone marketing page (its own document + styles, NOT the Starlight docs
 * theme). On-brand with the SDE tokens — warm near-black, one teal accent,
 * Instrument Serif / Inter / JetBrains Mono — but a marketing aesthetic.
 *
 * Message (operator direction, 2026-06-22): lead with the OUTCOME people buy —
 * accumulated project intelligence / continuity — not the mechanisms, and not
 * the Observatory. Name the user (the AI-native operator) and the pain
 * (continuity, not generation). The Observatory is demoted to evidence.
 *
 * Lives at /home for now so it does not collide with the Starlight docs root at
 * /. Promoting it to / is a follow-up (docs move under a /docs base).
 *
 * Copy is plain-descriptive per the project tone rule: describe what is, no
 * "the unlock", no defensive contrasts, no fabricated logos or metrics.
 */
const GITHUB = "https://github.com/Lizo-RoadTown/tapestry";
const DOCS = "/";
const OBSERVATORY = "/observatory";
const SETUP = `${DOCS}how-to/set-up-a-new-project/`;

// What Tapestry does — outcomes first, mechanism named second.
const CAPABILITIES = [
  {
    outcome: "Observe project evolution",
    mech: "Telemetry · Observatory",
    body:
      "Watch how each project's shape changes over time. Raw sessions become coordination episodes — intent, action, friction, structure — so the work is legible, not just logged.",
    icon: `<circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/>`,
  },
  {
    outcome: "Preserve knowledge",
    mech: "Memory",
    body:
      "Context, corrections, and the reasons behind decisions carry between sessions and across projects. The next session starts where the last one left off instead of from zero.",
    icon: `<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>`,
  },
  {
    outcome: "Discover patterns",
    mech: "Observer",
    body:
      "The observer reads what's actually happening and surfaces the patterns — what worked, what keeps breaking, where the same correction gets made again. Findings, not raw counters.",
    icon: `<path d="M12 2a9 9 0 1 0 9 9"/><path d="M12 7v5l3 2"/><path d="M16 3l5 2-2 5"/>`,
  },
  {
    outcome: "Build durable structure",
    mech: "Upskilling · Templates",
    body:
      "Repeated work becomes named, reusable skills and templates — available in every project by reference, not copy. Capability compounds instead of being rebuilt each time.",
    icon: `<path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M2 14l10 5 10-5"/><path d="M2 11l10 5 10-5"/>`,
  },
];

const PAINS = [
  "Every project starts from scratch.",
  "Useful interactions disappear after the session ends.",
  "The same workflows get recreated again and again.",
  "Nobody remembers why things worked.",
  "Project knowledge is scattered across chats, docs, code, and people.",
  "Teams can't see how their AI workflows are evolving.",
];

const SEGMENTS = [
  {
    who: "Solo builder",
    problem: "“I have ten projects, and I keep repeating myself.”",
    gives: ["Project intelligence", "Memory across repos", "Pattern discovery"],
  },
  {
    who: "Research team",
    problem: "“Knowledge walks out the door. Nobody knows why decisions were made.”",
    gives: ["Knowledge continuity", "Project shape", "Historical reconstruction"],
  },
  {
    who: "AI product team",
    problem: "“We have agents. We don't know if they're improving.”",
    gives: ["Coordination signals", "Observer interpretations", "The Observatory"],
  },
  {
    who: "Enterprise innovation",
    problem: "“Dozens of experiments, no institutional memory.”",
    gives: ["Cross-project intelligence", "Skill formation", "Reusable structures"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tapestry — project intelligence for AI-native teams</title>
    <meta
      name="description"
      content="Tapestry helps operators accumulate capability instead of rebuilding context. Observe project evolution, preserve knowledge, discover patterns, and turn repeated work into durable structure."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- ───────────────────────── nav ───────────────────────── -->
    <header class="nav">
      <div class="nav-in">
        <a class="wordmark" href="/home">Tapestry</a>
        <nav class="links">
          <a href="#what">Platform</a>
          <a href="#for">Use cases</a>
          <a href={DOCS}>Docs</a>
          <a href={GITHUB} class="gh" aria-label="GitHub repository">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5A12 12 0 0 0 8.2 23.9c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.6 18 4.9 18 4.9c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>
          </a>
        </nav>
        <a class="btn btn-sm" href={SETUP}>Get started</a>
      </div>
    </header>

    <main>
      <!-- ───────────────────────── hero ───────────────────────── -->
      <section class="hero">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-in reveal">
          <p class="kicker mono">Project intelligence platform</p>
          <h1 class="display">
            Project intelligence for<br /><span class="accent">AI-native teams.</span>
          </h1>
          <p class="lede">
            Tapestry helps operators accumulate capability instead of rebuilding context — observe
            project evolution, preserve knowledge, discover patterns, and turn repeated work into
            durable structure.
          </p>
          <div class="cta-row">
            <a class="btn btn-lg" href={SETUP}>Set up a project</a>
            <a class="btn btn-ghost btn-lg" href="#what">See how it works →</a>
          </div>
          <p class="hero-foot mono">For people who run many projects with agents, over time.</p>
        </div>
      </section>

      <!-- ─────────────────── problem / continuity ─────────────────── -->
      <section class="problem">
        <div class="problem-in">
          <p class="kicker mono">The problem</p>
          <h2 class="display sec-title">Most AI tools solve generation.<br /><span class="accent">Tapestry solves continuity.</span></h2>
          <p class="sec-sub">
            The model can write the code. What disappears is everything around it — the context, the
            reasons, the patterns that made the work good. That loss is where the cost is.
          </p>
          <ul class="pains">
            {PAINS.map((p, i) => (
              <li class="pain reveal">
                <span class="pain-n mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="pain-t">{p}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ──────────────────── what Tapestry does ──────────────────── -->
      <section class="what" id="what">
        <header class="sec-head">
          <p class="kicker mono">What it does</p>
          <h2 class="display sec-title">Capability that accumulates.</h2>
          <p class="sec-sub">Four things, each backed by a mechanism that keeps running across every project.</p>
        </header>
        <div class="cards">
          {CAPABILITIES.map((c) => (
            <article class="card reveal">
              <span class="card-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
              </span>
              <h3 class="card-outcome display">{c.outcome}</h3>
              <p class="card-mech mono">{c.mech}</p>
              <p class="card-body">{c.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ──────────────────── who it's for ──────────────────── -->
      <section class="for" id="for">
        <header class="sec-head">
          <p class="kicker mono">Who it's for</p>
          <h2 class="display sec-title">The AI-native operator.</h2>
          <p class="sec-sub">Someone who runs multiple projects, works with agents daily, and watches useful context vanish between them.</p>
        </header>
        <div class="segs">
          {SEGMENTS.map((s) => (
            <article class="seg reveal">
              <h3 class="seg-who">{s.who}</h3>
              <p class="seg-problem">{s.problem}</p>
              <ul class="seg-gives">
                {s.gives.map((g) => (
                  <li><span class="tick" aria-hidden="true">→</span>{g}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- ──────────────────── the evidence: observatory ──────────────────── -->
      <section class="evidence">
        <div class="evidence-copy reveal">
          <p class="kicker mono">The evidence</p>
          <h2 class="display sec-title">See it accumulate.</h2>
          <p class="sec-sub">
            The Observatory is how the intelligence becomes visible. Pick a variable, overlay another,
            and the observer explains what the view exposes — architecture churn against friction,
            working activity against durable structure. Signals that aren't instrumented yet are shown
            as blind, never faked.
          </p>
          <a class="pillar-link" href={OBSERVATORY}>Open the Observatory →</a>
        </div>
        <div class="frame reveal" aria-hidden="true">
          <div class="frame-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="frame-title mono">observatory · pattern cockpit</span></div>
          <div class="frame-body">
            <div class="frame-controls mono">
              <span class="chip">Show <b>architecture changes</b></span>
              <span class="chip">overlaid with <b>friction</b></span>
              <span class="chip rec">↳ relationship</span>
            </div>
            <svg class="frame-chart" viewBox="0 0 560 200" preserveAspectRatio="none">
              <line x1="28" y1="172" x2="540" y2="172" stroke="#2a2f31" />
              <line x1="28" y1="20" x2="28" y2="172" stroke="#2a2f31" />
              <path d="M28 150 L120 120 L212 132 L304 78 L396 92 L488 44 L540 56" fill="none" stroke="#5fd3da" stroke-width="2.5" />
              <path d="M28 160 L120 150 L212 110 L304 124 L396 70 L488 88 L540 60" fill="none" stroke="#d8b06a" stroke-width="2" stroke-dasharray="5 6" />
              <circle cx="304" cy="78" r="3.5" fill="#5fd3da" />
              <circle cx="488" cy="44" r="3.5" fill="#5fd3da" />
            </svg>
            <div class="frame-legend mono">
              <span><i class="sw" style="background:#5fd3da"></i>architecture changes</span>
              <span><i class="sw" style="background:#d8b06a"></i>friction <em>⊘ not instrumented</em></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ──────────────────── quickstart ──────────────────── -->
      <section class="quickstart">
        <div class="qs-copy reveal">
          <p class="kicker mono">Quickstart</p>
          <h2 class="display sec-title">Three commands in.</h2>
          <p class="sec-sub">
            Install the CLI, wire a project into the platform, and open the console. The agents pick up
            memory, telemetry, and the discipline rules from there.
          </p>
          <a class="pillar-link" href={SETUP}>Full setup guide →</a>
        </div>
        <div class="terminal reveal">
          <div class="frame-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="frame-title mono">bash</span></div>
          <pre class="term-body mono"><code><span class="c">{"# install the CLI"}</span>
<span class="p">$</span> pipx install tapestry-cli

<span class="c">{"# wire this project into the platform"}</span>
<span class="p">$</span> tapestry onboard

<span class="c">{"# open the live console"}</span>
<span class="p">$</span> tapestry observatory
<span class="o">{"→ opening https://tapestry-khaki.vercel.app/observatory"}</span></code></pre>
        </div>
      </section>

      <!-- ──────────────────── closing CTA ──────────────────── -->
      <section class="cta-band">
        <div class="cta-glow" aria-hidden="true"></div>
        <div class="reveal">
          <h2 class="display cta-title">Accumulate capability.<br /><span class="accent">Stop rebuilding context.</span></h2>
          <div class="cta-row center">
            <a class="btn btn-lg" href={SETUP}>Set up a project</a>
            <a class="btn btn-ghost btn-lg" href={GITHUB}>View on GitHub →</a>
          </div>
        </div>
      </section>
    </main>

    <!-- ──────────────────── footer ──────────────────── -->
    <footer class="footer">
      <div class="foot-in">
        <div class="foot-brand">
          <p class="wordmark">Tapestry</p>
          <p class="foot-tag">Project intelligence for AI-native teams. Accumulate capability instead of rebuilding context.</p>
        </div>
        <div class="foot-cols">
          <div class="foot-col">
            <p class="foot-h mono">Platform</p>
            <a href="#what">What it does</a>
            <a href={OBSERVATORY}>Observatory</a>
            <a href={`${DOCS}explanation/`}>How it works</a>
          </div>
          <div class="foot-col">
            <p class="foot-h mono">Learn</p>
            <a href={`${DOCS}explanation/`}>Concepts</a>
            <a href={`${DOCS}reference/`}>Reference</a>
            <a href={`${DOCS}start/what-tapestry-is-not/`}>What it is not</a>
          </div>
          <div class="foot-col">
            <p class="foot-h mono">Docs</p>
            <a href={DOCS}>Documentation</a>
            <a href={SETUP}>Quickstart</a>
            <a href={`${DOCS}how-to/recover-from-common-failures/`}>Recover from drift</a>
          </div>
          <div class="foot-col">
            <p class="foot-h mono">Community</p>
            <a href={GITHUB}>GitHub</a>
          </div>
        </div>
      </div>
      <p class="foot-fine mono">Built in parallel with the fleet it will eventually hold. Names are transitional.</p>
    </footer>

    <script>
      // Entrance reveal — fade-up, staggered, disabled under reduced-motion.
      const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
      if (rm || !("IntersectionObserver" in window)) {
        els.forEach((e) => e.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                (en.target as HTMLElement).classList.add("in");
                io.unobserve(en.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.08 },
        );
        els.forEach((e) => io.observe(e));
      }
    </script>

    <style>
      :root {
        color-scheme: dark;
        --surface: #0a0d0e;
        --surface-2: #0d1113;
        --raised: #14191b;
        --edge: #232a2c;
        --edge-soft: #1a2022;
        --ink: #f3f5f4;
        --dim: #c4ccca;
        --faint: #8b9492;
        --brand: #5fd3da;
        --warn: #d8b06a;
        --font-d: "Instrument Serif", Georgia, serif;
        --font-s: "Inter", system-ui, sans-serif;
        --font-m: "JetBrains Mono", ui-monospace, Consolas, monospace;
        --maxw: 1120px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font: 16px/1.6 var(--font-s);
        color: var(--ink);
        background: var(--surface);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
      .mono { font-family: var(--font-m); font-variant-numeric: tabular-nums; }
      .display { font-family: var(--font-d); font-weight: 400; letter-spacing: 0.01em; }
      .accent { font-family: var(--font-d); font-style: italic; background: linear-gradient(120deg, var(--brand), #9be8ec); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .kicker { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brand); margin: 0 0 14px; }

      /* reveal */
      .reveal { opacity: 0; transform: translateY(16px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
      .reveal.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } html { scroll-behavior: auto; } }

      /* buttons */
      .btn { display: inline-flex; align-items: center; gap: 8px; font: 500 14px var(--font-s); padding: 10px 18px; border-radius: 10px; background: var(--brand); color: #04211f; border: 1px solid transparent; cursor: pointer; transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease), background 0.18s; white-space: nowrap; }
      .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px -8px #5fd3da66; background: #74dde3; }
      .btn-lg { font-size: 15px; padding: 13px 24px; border-radius: 12px; }
      .btn-sm { padding: 8px 15px; font-size: 13px; }
      .btn-ghost { background: transparent; color: var(--ink); border: 1px solid var(--edge); }
      .btn-ghost:hover { background: #ffffff0a; border-color: var(--brand); box-shadow: none; }

      /* nav */
      .nav { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--edge-soft); background: #0a0d0ecc; backdrop-filter: blur(12px); }
      .nav-in { max-width: var(--maxw); margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; gap: 28px; }
      .wordmark { font-family: var(--font-d); font-size: 22px; letter-spacing: 0.01em; }
      .links { display: flex; align-items: center; gap: 24px; margin-left: auto; font-size: 14px; }
      .links a { color: var(--faint); transition: color 0.15s; }
      .links a:hover { color: var(--ink); }
      .links .gh { display: inline-flex; }
      .nav .btn-sm { margin-left: 4px; }

      /* hero */
      .hero { position: relative; overflow: hidden; padding: clamp(72px, 13vw, 150px) 24px clamp(56px, 9vw, 104px); }
      .hero-glow { position: absolute; inset: -20% 0 auto 0; height: 720px; background: radial-gradient(60% 70% at 50% 0%, #5fd3da26 0, #5fd3da0d 38%, transparent 70%); pointer-events: none; }
      .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(#ffffff08 1px, transparent 1px), linear-gradient(90deg, #ffffff08 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(75% 55% at 50% 30%, #000 0, transparent 80%); -webkit-mask-image: radial-gradient(75% 55% at 50% 30%, #000 0, transparent 80%); pointer-events: none; }
      .hero-in { position: relative; max-width: 880px; margin: 0 auto; text-align: center; }
      .hero h1 { font-size: clamp(46px, 8.4vw, 92px); line-height: 1.02; margin: 0 0 22px; letter-spacing: -0.01em; }
      .lede { font-size: clamp(17px, 2.1vw, 21px); line-height: 1.55; color: var(--dim); max-width: 60ch; margin: 0 auto; }
      .cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 34px; }
      .cta-row.center { justify-content: center; }
      .hero-foot { margin-top: 26px; font-size: 12.5px; color: var(--faint); letter-spacing: 0.02em; }

      /* section head */
      .sec-head { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; text-align: center; }
      .sec-head .sec-sub { margin-left: auto; margin-right: auto; }
      .sec-title { font-size: clamp(30px, 4.6vw, 50px); line-height: 1.07; margin: 0 0 14px; letter-spacing: -0.005em; }
      .sec-sub { font-size: clamp(16px, 1.8vw, 19px); color: var(--dim); max-width: 58ch; line-height: 1.55; margin: 0; }

      /* problem */
      .problem { border-top: 1px solid var(--edge-soft); padding: clamp(56px, 9vw, 104px) 24px; }
      .problem-in { max-width: 940px; margin: 0 auto; text-align: center; }
      .problem .sec-sub { margin: 0 auto; }
      .pains { list-style: none; padding: 0; margin: 44px auto 0; max-width: 880px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; text-align: left; }
      .pain { display: flex; align-items: baseline; gap: 14px; padding: 18px 20px; border: 1px solid var(--edge); border-radius: 12px; background: var(--surface-2); }
      .pain-n { color: var(--brand); font-size: 13px; flex: none; }
      .pain-t { font-size: 16px; color: var(--dim); line-height: 1.4; }

      /* what / cards */
      .what { padding: clamp(56px, 9vw, 104px) 0; border-top: 1px solid var(--edge-soft); }
      .cards { max-width: var(--maxw); margin: 46px auto 0; padding: 0 24px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
      .card { padding: 30px 28px; border: 1px solid var(--edge); border-radius: 18px; background: linear-gradient(180deg, var(--raised), var(--surface-2)); transition: transform 0.25s var(--ease), border-color 0.25s, box-shadow 0.25s; }
      .card:hover { transform: translateY(-4px); border-color: #34474a; box-shadow: 0 24px 50px -28px #000, 0 0 0 1px #5fd3da22; }
      .card-ic { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 12px; color: var(--brand); background: #5fd3da14; border: 1px solid #5fd3da33; margin-bottom: 18px; }
      .card-outcome { font-size: 27px; margin: 0 0 4px; }
      .card-mech { font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); margin: 0 0 14px; }
      .card-body { font-size: 15px; line-height: 1.62; color: var(--dim); margin: 0; }

      /* for / segments */
      .for { padding: clamp(56px, 9vw, 104px) 0; border-top: 1px solid var(--edge-soft); }
      .segs { max-width: var(--maxw); margin: 46px auto 0; padding: 0 24px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
      .seg { padding: 26px 22px; border: 1px solid var(--edge); border-radius: 16px; background: var(--surface-2); display: flex; flex-direction: column; }
      .seg-who { font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--brand); margin: 0 0 14px; font-weight: 600; }
      .seg-problem { font-family: var(--font-d); font-size: 21px; line-height: 1.3; color: var(--ink); margin: 0 0 20px; }
      .seg-gives { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-direction: column; gap: 9px; }
      .seg-gives li { font-size: 14px; color: var(--dim); display: flex; gap: 9px; align-items: baseline; }
      .seg-gives .tick { color: var(--brand); font-family: var(--font-m); flex: none; }

      /* shared link */
      .pillar-link { display: inline-block; font-size: 14px; font-weight: 500; color: var(--brand); transition: color 0.15s; }
      .pillar-link:hover { color: #82e2e8; }

      /* evidence + quickstart share frame layout */
      .evidence, .quickstart { max-width: var(--maxw); margin: 0 auto; padding: clamp(56px, 9vw, 104px) 24px; border-top: 1px solid var(--edge-soft); display: grid; align-items: center; gap: 56px; }
      .evidence { grid-template-columns: 0.92fr 1.08fr; }
      .quickstart { grid-template-columns: 0.82fr 1.18fr; }
      .evidence-copy .pillar-link, .qs-copy .pillar-link { margin-top: 26px; }
      .evidence .sec-head, .quickstart .sec-head { text-align: left; }
      .evidence .sec-title, .quickstart .sec-title { text-align: left; }

      .frame, .terminal { border: 1px solid var(--edge); border-radius: 16px; overflow: hidden; background: var(--surface-2); box-shadow: 0 40px 80px -40px #000; }
      .frame-bar { display: flex; align-items: center; gap: 7px; padding: 11px 14px; border-bottom: 1px solid var(--edge-soft); background: #0c1012; }
      .frame-bar .dot { width: 11px; height: 11px; border-radius: 50%; background: #2a3133; }
      .frame-title { margin-left: 10px; font-size: 11.5px; color: var(--faint); }
