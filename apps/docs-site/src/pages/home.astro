      .list-item { padding: 10px 12px; border-radius: 9px; font-size: 14px; color: var(--dim); transition: background 0.15s, color 0.15s; }
      .list-item:hover { background: #ffffff0a; color: var(--ink); }

      /* hero */
      .hero { position: relative; overflow: hidden; padding: clamp(64px, 11vw, 130px) 24px clamp(40px, 7vw, 80px); }
      .hero-glow { position: absolute; inset: -20% 0 auto 0; height: 720px; background: radial-gradient(60% 70% at 50% 0%, #5fd3da26 0, #5fd3da0d 38%, transparent 70%); pointer-events: none; }
      .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(#ffffff08 1px, transparent 1px), linear-gradient(90deg, #ffffff08 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(75% 60% at 50% 25%, #000 0, transparent 80%); -webkit-mask-image: radial-gradient(75% 60% at 50% 25%, #000 0, transparent 80%); pointer-events: none; }
