      .card:hover { transform: translateY(-4px); border-color: #34474a; box-shadow: 0 24px 50px -28px #000, 0 0 0 1px #5fd3da22; }
      .card-ic { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 12px; color: var(--brand); background: #5fd3da14; border: 1px solid #5fd3da33; margin-bottom: 18px; }
      .card-outcome { font-size: 27px; margin: 0 0 4px; }
