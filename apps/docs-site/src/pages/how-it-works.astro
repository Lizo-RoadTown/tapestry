---
/**
 * How It Works.
 *
 * Outcome-first (lead with the pain and outcome, not the label or mechanism): leads with
 * what Tapestry does (accumulate intelligence), not the architecture. Mechanisms
 * (observer, memory, observatory) appear as supporting evidence, after the
 * outcome. Copy follows the operator's draft (2026-06-23).
 */
import SiteLayout from "../layouts/SiteLayout.astro";

const SETUP = "/how-to/set-up-a-new-project/";
const OBSERVATORY = "/observatory";

const SIGNALS = [
  "recurring decisions",
  "corrections",
  "workflows",
  "memory usage",
  "architecture changes",
  "coordination between people and agents",
];

// The flow. "Project Intelligence" is the outcome; emphasized.
const FLOW = [
  { label: "Project activity", key: false },
  { label: "Signals", key: false },
  { label: "Observer", key: false },
  { label: "Project intelligence", key: true },
  { label: "Observatory", key: false },
  { label: "Pattern discovery", key: false },
];
---

<SiteLayout title="How Tapestry works" description="Most AI tools help generate outputs. Tapestry helps projects accumulate intelligence — observing the patterns that emerge around your work and helping projects retain what they've learned." activeNav="platform">
  <!-- hero: outcome contrast -->
  <section class="hw-hero">
    <div class="hw-glow" aria-hidden="true"></div>
    <div class="hw-hero-in reveal">
      <p class="kicker mono">How it works</p>
      <h1 class="display">Most AI tools help<br />generate <span class="accent">outputs.</span></h1>
      <p class="hw-sub">Tapestry helps projects accumulate <span class="hw-strong">intelligence.</span></p>
      <div class="cta-row">
        <a class="btn btn-lg" href={SETUP}>Set up a project</a>
        <a class="btn btn-ghost btn-lg" href="#flow">See the flow →</a>
      </div>
    </div>
  </section>

  <!-- what it observes -->
  <section class="hw-observe">
    <div class="hw-observe-in">
      <p class="hw-lead reveal">As you work, Tapestry observes the patterns that emerge around your project:</p>
      <ul class="hw-signals reveal">
        {SIGNALS.map((s) => (<li><span class="tick" aria-hidden="true">→</span>{s}</li>))}
      </ul>
      <p class="hw-becomes reveal">Those signals become <span class="hw-strong">project intelligence.</span></p>
      <p class="hw-detail reveal">The observer identifies patterns, memory preserves useful context, and the Observatory helps you explore how projects evolve over time. Instead of treating every session as a fresh start, Tapestry helps projects retain what they've learned.</p>
    </div>
  </section>

  <!-- the flow -->
  <section class="hw-flow" id="flow">
    <header class="sec-head">
      <p class="kicker mono">The flow</p>
      <h2 class="display sec-title">Activity in. Intelligence out.</h2>
    </header>
    <ol class="hw-flow-chain reveal">
      {FLOW.map((step, i) => (
        <li class="hw-step-wrap">
          <div class={`hw-step${step.key ? " key" : ""}`}>{step.label}</div>
          {i < FLOW.length - 1 && <span class="hw-arrow" aria-hidden="true">↓</span>}
        </li>
      ))}
    </ol>
  </section>

  <!-- goal -->
  <section class="hw-goal">
    <div class="hw-goal-in reveal">
      <p class="kicker mono">The goal</p>
      <h2 class="display hw-goal-title">Spend less time rebuilding context.<br /><span class="accent">More time building capability.</span></h2>
      <div class="cta-row center">
        <a class="btn btn-lg" href={SETUP}>Set up a project</a>
        <a class="btn btn-ghost btn-lg" href={OBSERVATORY}>Open the Observatory →</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hw-hero { position: relative; overflow: hidden; padding: clamp(72px, 12vw, 140px) 24px clamp(48px, 8vw, 80px); text-align: center; }
  .hw-glow { position: absolute; inset: -20% 0 auto 0; height: 680px; background: radial-gradient(58% 65% at 50% 0%, #5fd3da26 0, #5fd3da0d 38%, transparent 70%); pointer-events: none; }
  .hw-hero-in { position: relative; max-width: 820px; margin: 0 auto; }
  .hw-hero h1 { font-size: clamp(46px, 8vw, 84px); line-height: 1.03; margin: 0 0 18px; letter-spacing: -0.01em; }
  .hw-sub { font-size: clamp(20px, 2.8vw, 30px); color: var(--dim); margin: 0; font-family: var(--font-d); }
  .hw-strong { color: var(--ink); }
  .cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
  .cta-row.center { justify-content: center; }

  /* observe */
  .hw-observe { border-top: 1px solid var(--edge-soft); padding: clamp(56px, 9vw, 96px) 24px; }
  .hw-observe-in { max-width: 720px; margin: 0 auto; }
  .hw-lead { font-size: clamp(18px, 2.2vw, 22px); color: var(--dim); margin: 0 0 22px; }
  .hw-signals { list-style: none; padding: 0; margin: 0 0 26px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 28px; }
  .hw-signals li { display: flex; gap: 11px; align-items: baseline; font-size: 16px; color: var(--dim); }
  .tick { color: var(--brand); font-family: var(--font-m); flex: none; }
  .hw-becomes { font-family: var(--font-d); font-size: clamp(22px, 2.8vw, 30px); color: var(--dim); margin: 0 0 24px; }
  .hw-detail { font-size: clamp(16px, 1.9vw, 19px); line-height: 1.6; color: var(--dim); margin: 0; }

  /* flow */
  .hw-flow { border-top: 1px solid var(--edge-soft); padding: clamp(56px, 9vw, 104px) 24px; }
  .hw-flow-chain { list-style: none; padding: 0; margin: 46px auto 0; max-width: 420px; display: flex; flex-direction: column; align-items: center; gap: 0; }
  .hw-step-wrap { display: flex; flex-direction: column; align-items: center; width: 100%; }
  .hw-step { width: 100%; text-align: center; padding: 16px 20px; border: 1px solid var(--edge); border-radius: 12px; background: var(--surface-2); font-size: 15px; color: var(--dim); }
  .hw-step.key { border-color: #5fd3da55; background: linear-gradient(180deg, #11211f, var(--surface-2)); color: var(--brand); font-weight: 500; box-shadow: 0 0 0 1px #5fd3da22, 0 16px 40px -22px #5fd3da55; }
  .hw-arrow { color: var(--faint); font-size: 18px; line-height: 1; padding: 8px 0; }

  /* goal */
  .hw-goal { position: relative; overflow: hidden; text-align: center; padding: clamp(72px, 12vw, 140px) 24px; border-top: 1px solid var(--edge-soft); }
  .hw-goal-in { max-width: 820px; margin: 0 auto; }
  .hw-goal-title { font-size: clamp(30px, 5vw, 56px); line-height: 1.08; margin: 0 0 30px; }

  @media (max-width: 560px) {
    .hw-signals { grid-template-columns: 1fr; }
  }
</style>
