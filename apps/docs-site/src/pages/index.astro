---
/**
 * Tapestry — front page. Uses the shared SiteLayout (nav /
 * footer / design system); only the page-specific sections + styles live here.
 *
 * Message: lead with the OUTCOME (accumulated project intelligence /
 * continuity), name the user (AI-native operator) and pain (continuity, not
 * generation). Observatory is demoted to evidence. Recursive-iteration hero
 * (a loop that accumulates each pass), not a lifecycle. Serves at / (the site
 * front door); the docs landing lives at /docs/ and /home redirects here.
 */
import SiteLayout from "../layouts/SiteLayout.astro";

const GITHUB = "https://github.com/Lizo-RoadTown/tapestry";
const DOCS = "/";
const OBSERVATORY = "/observatory";
const SETUP = `${DOCS}how-to/set-up-a-new-project/`;

const CAPABILITIES = [
  { outcome: "Observe project evolution", mech: "Telemetry · Observatory", body: "See what changed, what got stuck, and what became part of the project.", icon: `<circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/>` },
  { outcome: "Preserve knowledge", mech: "Memory", body: "Carry decisions, corrections, and context forward between sessions.", icon: `<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>` },
  { outcome: "Discover patterns", mech: "Observer", body: "Find the repeated fixes, failures, and useful moves hiding in the work.", icon: `<path d="M12 2a9 9 0 1 0 9 9"/><path d="M12 7v5l3 2"/><path d="M16 3l5 2-2 5"/>` },
  { outcome: "Build durable structure", mech: "Upskilling · Templates", body: "Turn repeated work into reusable skills, templates, and workflows.", icon: `<path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M2 14l10 5 10-5"/><path d="M2 11l10 5 10-5"/>` },
];
const PAINS = [
  "Every project starts from scratch.",
  "Useful interactions disappear after the session ends.",
  "The same workflows get recreated again and again.",
  "Nobody remembers why things worked.",
  "Project knowledge is scattered across chats, docs, code, and people.",
  "Teams can't see how their AI workflows are evolving.",
];
const SEGMENTS = [
  { who: "Solo builder", problem: "“I have ten projects, and I keep repeating myself.”", gives: ["Project intelligence", "Memory across repos", "Pattern discovery"] },
  { who: "Research team", problem: "“Knowledge walks out the door. Nobody knows why decisions were made.”", gives: ["Knowledge continuity", "Project shape", "Historical reconstruction"] },
  { who: "AI product team", problem: "“We have agents. We don't know if they're improving.”", gives: ["Coordination signals", "Observer interpretations", "The Observatory"] },
  { who: "Enterprise innovation", problem: "“Dozens of experiments, no institutional memory.”", gives: ["Cross-project intelligence", "Skill formation", "Reusable structures"] },
];
const PILLARS = [
  { title: "Woven Recursion", body: "Each cycle weaves through the last, strengthening the whole.", icon: `<path d="M5 8 16 19M8 5 19 16M19 8 8 19M16 5 5 16"/>` },
  { title: "Growing Structure", body: "Every loop expands the system, adding capability and context.", icon: `<circle cx="12" cy="12" r="6.5"/><circle cx="11" cy="6" r="1.3" fill="currentColor" stroke="none"/><path d="M16.8 7.6 18.6 9.2 16.9 11"/>` },
  { title: "Compound Intelligence", body: "Connections create structure. Structure enables outcomes.", icon: `<circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>` },
  { title: "Built to Evolve", body: "Skills grow. Systems adapt. Results compound.", icon: `<path d="M4 20h16M8 20v-4M12 20v-7M16 20v-10"/><path d="M5 14 10 10 13 12 19 6"/><path d="M16 6h3v3"/>` },
];
const STAGES = [
  { label: "Initial cycle", sub: "Establish", body: "One project, one loop — work observed, knowledge kept.", icon: `<circle cx="20" cy="20" r="13"/><circle cx="20" cy="20" r="2.6"/><circle cx="20" cy="7" r="2.2" fill="currentColor" stroke="none"/><circle cx="20" cy="33" r="2.2" fill="currentColor" stroke="none"/>` },
  { label: "Recursive cycles", sub: "Strengthen", body: "Loops compound; patterns recur and harden into structure.", icon: `<circle cx="20" cy="20" r="2.6"/><ellipse cx="20" cy="20" rx="16" ry="6"/><ellipse cx="20" cy="20" rx="16" ry="6" transform="rotate(60 20 20)"/><ellipse cx="20" cy="20" rx="16" ry="6" transform="rotate(120 20 20)"/>` },
  { label: "Compound intelligence", sub: "Scale", body: "Structure carries across projects; the whole system gets sharper.", icon: `<g transform="rotate(45 20 20)"><rect x="9" y="9" width="22" height="22" rx="6" stroke-opacity="0.4"/><rect x="13" y="13" width="14" height="14" rx="4" stroke-opacity="0.7"/><rect x="16.5" y="16.5" width="7" height="7" rx="2"/></g><circle cx="20" cy="20" r="2.5" fill="currentColor" stroke="none"/>` },
];
---

<SiteLayout title="Tapestry: project intelligence for AI-native teams" description="Tapestry turns repeated work into structure that compounds. It tracks project change, preserves context, finds patterns, and makes useful repeats reusable.">
  <!-- hero -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-in reveal">
      <p class="kicker mono">Project intelligence platform</p>
      <h1 class="display">Project intelligence <em class="made-word">made</em> for<br /><span class="accent">AI-native teams.</span></h1>
      <p class="lede">Tapestry turns repeated work into structure that compounds. It tracks project change, preserves context, finds patterns, and makes useful repeats reusable.</p>
      <div class="cta-row">
        <a class="btn btn-lg" href={SETUP}>Set up a project</a>
        <a class="btn btn-ghost btn-lg" href="#what">See how it works →</a>
      </div>
    </div>

    <figure class="viz reveal" aria-label="The Tapestry mark: woven layers of work, observation, discovery, and reuse, compounding around a shared core.">
      <img class="viz-img" src="/tapestry-hero.png" alt="The Tapestry mark: a woven emblem of work, observation, discovery, and reuse around a glowing core." />
      <figcaption class="viz-cap mono">Each project builds on the last.</figcaption>
    </figure>
  </section>

  <!-- what it does -->
  <section class="what" id="what">
    <header class="sec-head">
      <p class="kicker mono">What it does</p>
      <h2 class="display sec-title">Structure that <span class="accent">compounds.</span></h2>
      <p class="sec-sub">Four things, each backed by a mechanism that keeps running across every project.</p>
    </header>
    <div class="cards">
      {CAPABILITIES.map((c) => (
        <article class="card reveal">
          <span class="card-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} /></span>
          <h3 class="card-outcome display">{c.outcome}</h3>
          <p class="card-mech mono">{c.mech}</p>
          <p class="card-body">{c.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- pillars -->
  <section class="pillars">
    <header class="sec-head">
      <p class="kicker mono">What makes it compound</p>
      <h2 class="display sec-title">Four principles, one fabric.</h2>
    </header>
    <div class="pillar-grid">
      {PILLARS.map((p) => (
        <article class="pillar reveal">
          <span class="pillar-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} /></span>
          <h3 class="pillar-t mono">{p.title}</h3>
          <p class="pillar-b">{p.body}</p>
        </article>
      ))}
    </div>
    <p class="story-close">Tapestry turns repeated agent work into reusable structure. Each cycle keeps what was learned, connects it to the project, and <span class="accent">makes the next cycle easier to build on.</span></p>
  </section>

  <!-- go deeper -->
  <section class="explore">
    <p class="explore-text mono">Go deeper: <a href="/use-cases">use cases</a> · <a href="/open-source">open source</a> · <a href="/project-intelligence">project intelligence</a> · <a href="/observatory">the Observatory</a></p>
  </section>

  <!-- quickstart -->
  <section class="quickstart">
    <div class="qs-copy reveal">
      <p class="kicker mono">Quickstart</p>
      <h2 class="display sec-title">Three commands in.</h2>
      <p class="sec-sub">Install the CLI, wire a project into the platform, and open the console. The agents pick up memory, telemetry, and the discipline rules from there.</p>
      <a class="pillar-link" href={SETUP}>Full setup guide →</a>
    </div>
    <div class="terminal reveal">
      <div class="frame-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="frame-title mono">bash</span></div>
      <pre class="term-body mono"><code><span class="c">{"# install the CLI"}</span>
<span class="p">$</span> pipx install tapestry-cli

<span class="c">{"# wire this project into the platform"}</span>
<span class="p">$</span> tapestry onboard

<span class="c">{"# open the live console"}</span>
<span class="p">$</span> tapestry observatory
<span class="o">{"→ opening https://tapestry-khaki.vercel.app/observatory"}</span></code></pre>
    </div>
  </section>

  <!-- closing CTA -->
  <section class="cta-band">
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="reveal">
      <h2 class="display cta-title">Turn repeated work into structure.<br /><span class="accent">Keep the context that makes it useful.</span></h2>
      <div class="cta-row center"><a class="btn btn-lg" href={SETUP}>Set up a project</a><a class="btn btn-ghost btn-lg" href={GITHUB}>View on GitHub →</a></div>
    </div>
  </section>
</SiteLayout>

<style>
  /* hero */
  .hero { position: relative; overflow: hidden; padding: clamp(64px, 11vw, 130px) 24px clamp(40px, 7vw, 80px); }
  .hero-glow { position: absolute; inset: -20% 0 auto 0; height: 720px; background: radial-gradient(60% 70% at 50% 0%, #5fd3da26 0, #5fd3da0d 38%, transparent 70%); pointer-events: none; }
  .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(#ffffff08 1px, transparent 1px), linear-gradient(90deg, #ffffff08 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(75% 60% at 50% 25%, #000 0, transparent 80%); -webkit-mask-image: radial-gradient(75% 60% at 50% 25%, #000 0, transparent 80%); pointer-events: none; }
  .hero-in { position: relative; max-width: 880px; margin: 0 auto; text-align: center; }
  .hero h1 { font-size: clamp(46px, 8.4vw, 92px); line-height: 1.02; margin: 0 0 22px; letter-spacing: -0.01em; }
  .lede { font-size: clamp(17px, 2.1vw, 21px); line-height: 1.55; color: var(--dim); max-width: 60ch; margin: 0 auto; }
  .cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 34px; }
  .cta-row.center { justify-content: center; }

  /* hero recursive visual */
  .viz { position: relative; max-width: 560px; margin: clamp(24px, 5vw, 52px) auto 0; padding: 0; }
  .viz-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .viz-img { width: 100%; max-width: 560px; height: auto; display: block; margin: 8px auto 0; mix-blend-mode: lighten; }
  .vnode rect { fill: #0d1214; stroke: #2e3a3c; }
  .vnode text { fill: var(--brand); font-family: var(--font-m); font-size: 12px; text-anchor: middle; dominant-baseline: middle; }
  .viz-cap { text-align: center; font-size: 12px; color: var(--faint); margin: 14px auto 0; max-width: 46ch; line-height: 1.5; }
  .orbit { transform-box: view-box; transform-origin: 320px 250px; animation: orbit 16s linear infinite; }
  .flow { stroke-dasharray: 3 10; animation: flow 1.3s linear infinite; }
  .pulse { transform-box: view-box; transform-origin: 320px 250px; animation: pulse 3.2s ease-in-out infinite; }
  @keyframes orbit { to { transform: rotate(360deg); } }
  @keyframes flow { to { stroke-dashoffset: -13; } }
  @keyframes pulse { 0% { transform: scale(1); opacity: 0.5; } 100% { transform: scale(2.6); opacity: 0; } }

  /* problem */
  .problem { border-top: 1px solid var(--edge-soft); padding: clamp(56px, 9vw, 104px) 24px; }
  .explore { border-top: 1px solid var(--edge-soft); padding: clamp(40px, 6vw, 72px) 24px; text-align: center; }
  .explore-text { font-size: 13.5px; color: var(--faint); letter-spacing: 0.02em; margin: 0; }
  .explore-text a { color: var(--brand); }
  .explore-text a:hover { color: #82e2e8; }
  .problem-in { max-width: 940px; margin: 0 auto; text-align: center; }
  .problem .sec-sub { margin: 0 auto; }
  .pains { list-style: none; padding: 0; margin: 44px auto 0; max-width: 880px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; text-align: left; }
  .pain { display: flex; align-items: baseline; gap: 14px; padding: 18px 20px; border: 1px solid var(--edge); border-radius: 12px; background: var(--surface-2); }
  .pain-n { color: var(--brand); font-size: 13px; flex: none; }
  .pain-t { font-size: 16px; color: var(--dim); line-height: 1.4; }

  /* what / cards */
  .what { padding: clamp(56px, 9vw, 104px) 0; border-top: 1px solid var(--edge-soft); }
  .cards { max-width: var(--maxw); margin: 46px auto 0; padding: 0 24px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .card { padding: 30px 28px; border: 1px solid var(--edge); border-radius: 18px; background: linear-gradient(180deg, var(--raised), var(--surface-2)); transition: transform 0.25s var(--ease), border-color 0.25s, box-shadow 0.25s; }
  .card:hover { transform: translateY(-4px); border-color: #34474a; box-shadow: 0 24px 50px -28px #000, 0 0 0 1px #5fd3da22; }
  .card-ic { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 12px; color: var(--brand); background: #5fd3da14; border: 1px solid #5fd3da33; margin-bottom: 18px; }
  .card-outcome { font-size: 27px; margin: 0 0 4px; }
  .card-mech { font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); margin: 0 0 14px; }
  .card-body { font-size: 15px; line-height: 1.62; color: var(--dim); margin: 0; }

  /* open platform */
  .oss { padding: clamp(56px, 9vw, 104px) 0; border-top: 1px solid var(--edge-soft); }
  .oss-grid { max-width: var(--maxw); margin: 46px auto 0; padding: 0 24px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .osd { display: flex; flex-direction: column; }
  .osd-viz { border: 1px solid var(--edge); border-radius: 14px; background: #090d0e; margin-bottom: 18px; overflow: hidden; }
  .osd-viz svg { width: 100%; height: auto; display: block; }
  .dg-node rect { fill: #0e1416; stroke: #2c3a3d; }
  .dg-node.hub rect { fill: #11211f; stroke: #3d6d6a; }
  .dg-node text { fill: var(--dim); font-family: var(--font-m); font-size: 11px; text-anchor: middle; dominant-baseline: middle; }
  .dg-node.hub text { fill: var(--brand); }
  .dg-edge { fill: none; stroke: #5fd3da; stroke-opacity: 0.45; stroke-width: 1.4; stroke-dasharray: 2 5; }
  .osd-head { display: flex; align-items: center; gap: 9px; margin-bottom: 10px; }
  .osd-ic { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 8px; color: var(--brand); background: #5fd3da12; border: 1px solid #5fd3da26; }
  .osd-name { font-size: 13px; color: var(--ink); }
  .osd-title { font-size: 23px; line-height: 1.15; margin: 0 0 8px; }
  .osd-sub { font-size: 14px; color: var(--dim); line-height: 1.55; margin: 0 0 16px; }
  .osd .pillar-link { margin-top: auto; }

  /* for / segments */
  .for { padding: clamp(56px, 9vw, 104px) 0; border-top: 1px solid var(--edge-soft); }
  .segs { max-width: var(--maxw); margin: 46px auto 0; padding: 0 24px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .seg { padding: 26px 22px; border: 1px solid var(--edge); border-radius: 16px; background: var(--surface-2); display: flex; flex-direction: column; }
  .seg-who { font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--brand); margin: 0 0 14px; font-weight: 600; }
  .seg-problem { font-family: var(--font-d); font-size: 21px; line-height: 1.3; color: var(--ink); margin: 0 0 20px; }
  .seg-gives { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-direction: column; gap: 9px; }
  .seg-gives li { font-size: 14px; color: var(--dim); display: flex; gap: 9px; align-items: baseline; }
  .seg-gives .tick { color: var(--brand); font-family: var(--font-m); flex: none; }

  /* evidence + quickstart */
  .evidence, .quickstart { max-width: var(--maxw); margin: 0 auto; padding: clamp(56px, 9vw, 104px) 24px; border-top: 1px solid var(--edge-soft); display: grid; align-items: center; gap: 56px; }
  .evidence { grid-template-columns: 0.92fr 1.08fr; }
  .quickstart { grid-template-columns: 0.82fr 1.18fr; }
  .evidence-copy .pillar-link, .qs-copy .pillar-link { margin-top: 26px; }
  .evidence .sec-title, .quickstart .sec-title { text-align: left; }

  .frame, .terminal { border: 1px solid var(--edge); border-radius: 16px; overflow: hidden; background: var(--surface-2); box-shadow: 0 40px 80px -40px #000; }
  .frame-bar { display: flex; align-items: center; gap: 7px; padding: 11px 14px; border-bottom: 1px solid var(--edge-soft); background: #0c1012; }
  .frame-bar .dot { width: 11px; height: 11px; border-radius: 50%; background: #2a3133; }
  .frame-title { margin-left: 10px; font-size: 11.5px; color: var(--faint); }
  .frame-body { padding: 18px; }
  .frame-controls { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; font-size: 12px; }
  .chip { padding: 5px 11px; border: 1px solid var(--edge); border-radius: 999px; color: var(--dim); background: #ffffff05; }
  .chip b { color: var(--ink); font-weight: 500; }
  .chip.rec { color: var(--brand); border-color: #5fd3da40; }
  .frame-chart { width: 100%; height: 188px; display: block; }
  .frame-legend { display: flex; gap: 18px; margin-top: 8px; font-size: 11.5px; color: var(--dim); flex-wrap: wrap; }
  .frame-legend .sw { display: inline-block; width: 13px; height: 3px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
  .frame-legend em { color: var(--warn); font-style: normal; margin-left: 4px; }
  .terminal { background: #0b0f10; }
  .term-body { margin: 0; padding: 20px 22px; font-size: 13.5px; line-height: 1.85; color: var(--dim); overflow-x: auto; }
  .term-body .p { color: var(--brand); user-select: none; margin-right: 8px; }
  .term-body .c { color: var(--faint); }
  .term-body .o { color: var(--warn); }

  /* closing cta */
  .cta-band { position: relative; overflow: hidden; text-align: center; padding: clamp(80px, 13vw, 150px) 24px; border-top: 1px solid var(--edge-soft); }
  .cta-glow { position: absolute; inset: auto 0 -40% 0; height: 560px; background: radial-gradient(55% 70% at 50% 100%, #5fd3da22 0, transparent 70%); pointer-events: none; }
  .cta-title { position: relative; font-size: clamp(34px, 6vw, 68px); line-height: 1.07; margin: 0 0 34px; }

  @media (max-width: 980px) {
    .cards { grid-template-columns: 1fr; }
    .oss-grid { grid-template-columns: 1fr; }
    .segs { grid-template-columns: repeat(2, 1fr); }
    .evidence, .quickstart { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 620px) {
    .pains { grid-template-columns: 1fr; }
    .segs { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit, .flow, .pulse { animation: none; }
  }

  /* pillars */
  .pillars { max-width: var(--maxw); margin: 0 auto; padding: clamp(44px, 7vw, 88px) 24px clamp(48px, 8vw, 92px); }
  .pillar-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 42px; }
  .pillar { padding: 24px 22px; border: 1px solid var(--edge); border-radius: 16px; background: linear-gradient(180deg, var(--raised), var(--surface-2)); transition: border-color 0.25s, transform 0.25s var(--ease); }
  .pillar:hover { border-color: #34474a; transform: translateY(-3px); }
  .pillar-ic { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 12px; color: var(--brand); background: #5fd3da12; border: 1px solid #5fd3da26; margin-bottom: 18px; }
  .pillar-t { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand); margin: 0 0 9px; }
  .pillar-b { font-size: 14.5px; line-height: 1.5; color: var(--dim); margin: 0; }

  /* growth storyline */
  .story { max-width: var(--maxw); margin: 0 auto; padding: clamp(48px, 8vw, 96px) 24px; }
  .story-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 46px; }
  .stage { text-align: center; padding: 0 10px; }
  .stage-ic { display: inline-flex; color: var(--brand); margin-bottom: 14px; }
  .stage-t { font-size: 21px; margin: 0 0 3px; }
  .stage-sub { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand); margin: 0 0 12px; }
  .stage-b { font-size: 14px; line-height: 1.55; color: var(--dim); margin: 0 auto; max-width: 28ch; }
  .story-close { text-align: center; max-width: 56ch; margin: 52px auto 0; font-family: var(--font-d); font-weight: 500; font-size: clamp(19px, 2.4vw, 26px); line-height: 1.4; color: var(--ink); }

  @media (max-width: 860px) {
    .pillar-grid { grid-template-columns: repeat(2, 1fr); }
    .story-row { grid-template-columns: 1fr; gap: 38px; }
  }
</style>
