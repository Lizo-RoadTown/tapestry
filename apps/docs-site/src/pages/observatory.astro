---
/**
 * The Observatory — the coordination-support view over OTEL telemetry.
 *
 * Inside the docs site (same Astro project / deploy / domain), at /observatory.
 * Canon: docs/canon/user-agent-coordination-reinforcement.md.
 * Contract: docs-site reference/otel-coordination-contract.md.
 *
 * Reads OTEL-backed telemetry; it is not Grafana. Grafana is the substrate;
 * this is the coordination-support layer over it.
 *
 * State rule (binding): healthy / degraded / blind / unknown. Blind means the
 * signal is not instrumented yet — never "nothing is wrong." Missing signal is
 * never shown as healthy.
 *
 * Today the coordination contract is not emitted yet, so coordination health is
 * mostly blind. What IS real is instrumentation coverage: which contract
 * attributes the hooks emit now (PROBE'd from _observability.py + hooks.jsonl).
 */

type State = "healthy" | "degraded" | "blind" | "unknown";
const STATE_GLYPH: Record<State, string> = { healthy: "●", degraded: "◐", blind: "⊘", unknown: "○" };
const STATE_LABEL: Record<State, string> = {
  healthy: "healthy",
  degraded: "degraded",
  blind: "blind — signal not instrumented yet",
  unknown: "unknown — no reading yet",
};

// Instrumentation coverage = the one real reading today. PROBE'd:
//   _observability.py:154+ pushes OTLP/HTTP to Grafana Cloud; hooks.jsonl mirrors.
//   Today's events carry hook/tool/project/session + a free-text `note`.
type Cov = "emitted" | "in_note" | "blind";
const COV_GLYPH: Record<Cov, string> = { emitted: "●", in_note: "◐", blind: "⊘" };
const COV_LABEL: Record<Cov, string> = {
  emitted: "emitted as a typed field",
  in_note: "present, but as free-text in note",
  blind: "not emitted",
};

const COVERAGE: { group: string; attrs: { name: string; cov: Cov; note?: string }[] }[] = [
  {
    group: "Anchor",
    attrs: [{ name: "tapestry.coordination_context_id", cov: "blind", note: "events anchor on session_id + project_id today" }],
  },
  {
    group: "Required context",
    attrs: [
      { name: "tapestry.project_id", cov: "emitted" },
      { name: "tapestry.session_id", cov: "emitted" },
      { name: "tapestry.agent_id", cov: "blind" },
      { name: "tapestry.agent_role", cov: "blind" },
      { name: "tapestry.surface_id / workflow_surface", cov: "blind" },
      { name: "tapestry.surface_type", cov: "blind" },
    ],
  },
  {
    group: "Mechanism attributes",
    attrs: [
      { name: "tapestry.hook_name", cov: "emitted" },
      { name: "tapestry.tool_name", cov: "emitted", note: "PreToolUse" },
      { name: "tapestry.architecture_snapshot_id", cov: "in_note", note: "snapshot filename in note" },
      { name: "tapestry.diff_report_id", cov: "in_note", note: "diff filename in note" },
      { name: "tapestry.observer_ran", cov: "in_note" },
      { name: "tapestry.observer_detected_count", cov: "in_note" },
      { name: "tapestry.observer_created_count", cov: "in_note" },
      { name: "tapestry.observer_updated_count", cov: "in_note" },
      { name: "tapestry.friction_present", cov: "in_note", note: "stop-audit detects; transient warning" },
      { name: "tapestry.friction_type", cov: "blind" },
      { name: "tapestry.correction_present", cov: "in_note", note: "stop-audit detects; transient warning" },
      { name: "tapestry.memory_read_count", cov: "blind" },
      { name: "tapestry.memory_write_count", cov: "blind" },
      { name: "tapestry.memory_miss", cov: "blind" },
      { name: "tapestry.upskill_candidate_present", cov: "in_note", note: "observer counts" },
    ],
  },
];

const covCount = (c: Cov) => COVERAGE.flatMap((g) => g.attrs).filter((a) => a.cov === c).length;
const totalAttrs = COVERAGE.flatMap((g) => g.attrs).length;

// Coordination health, today. Honest: the contract is not emitted, so per-mechanism
// coordination quality is blind. The structure is shown; the readings are not faked.
const MECHANISMS: { label: string; state: State; why: string }[] = [
  { label: "Memory", state: "blind", why: "read/write/miss counts not emitted yet" },
  { label: "Architecture", state: "unknown", why: "snapshots produced; not yet read as a coordination signal" },
  { label: "Policy & audit", state: "unknown", why: "decisions recorded; not yet attributed to coordination" },
  { label: "Friction / correction", state: "blind", why: "detected as transient warnings; no typed signal" },
  { label: "Observability", state: "blind", why: "observer counts in note; not coordination-attributed" },
  { label: "Upskilling", state: "blind", why: "candidate counts in note; not attributed" },
  { label: "Telemetry", state: "degraded", why: "transport live; coordination shape not emitted" },
  { label: "Runtime", state: "blind", why: "invocation/session signals not coordination-anchored" },
];

const CANON_URL = "https://github.com/Lizo-RoadTown/tapestry/blob/main/docs/canon/user-agent-coordination-reinforcement.md";
const CONTRACT_URL = "/reference/otel-coordination-contract/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Observatory — Tapestry</title>
    <meta name="description" content="The coordination-support view over OTEL telemetry: how healthy operator-agent coordination is across projects, and which signals are instrumented yet." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href="/">Tapestry</a>
      <nav class="topnav" aria-label="primary">
        <a href="/">Docs</a>
        <a class="here" aria-current="page" href="/observatory">Observatory</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow mono">coordination-support view · over OTEL telemetry</p>
        <h1 class="display">The <span class="display-accent">Observatory</span></h1>
        <p class="lede">
          How healthy is coordination between you and your agents — across projects — and which signals are
          instrumented enough to tell. OTEL carries the signal; this reads it as coordination quality.
        </p>
      </section>

      <!-- the state vocabulary, stated once, up front -->
      <section class="states" aria-label="state legend">
        <span class="st healthy"><span class="g mono">●</span> healthy</span>
        <span class="st degraded"><span class="g mono">◐</span> degraded</span>
        <span class="st blind"><span class="g mono">⊘</span> blind</span>
        <span class="st unknown"><span class="g mono">○</span> unknown</span>
        <p class="states-note"><strong>Blind ≠ healthy.</strong> Blind means the signal isn't instrumented yet. Missing signal is never shown as healthy.</p>
      </section>

      <!-- L0: coordination health today (honest: mostly blind) -->
      <section aria-labelledby="health-h">
        <div class="section-head">
          <h2 id="health-h" class="display">Coordination health</h2>
          <p class="hint">Per reinforcement mechanism, across the fleet. The contract isn't emitted yet, so most readings are blind — the structure is shown, the readings are not faked.</p>
        </div>
        <ul class="mech-grid">
          {MECHANISMS.map((m) => (
            <li class={`mech ${m.state}`}>
              <div class="mech-top">
                <span class="mech-name">{m.label}</span>
                <span class={`state-pill ${m.state}`} title={STATE_LABEL[m.state]}>
                  <span class="g mono" aria-hidden="true">{STATE_GLYPH[m.state]}</span>{m.state}
                </span>
              </div>
              <p class="mech-why">{m.why}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- the one real reading today: instrumentation coverage -->
      <section aria-labelledby="cov-h">
        <div class="section-head">
          <h2 id="cov-h" class="display">Instrumentation coverage</h2>
          <p class="hint">
            What the hooks emit today (PROBE'd from <code>_observability.py</code> + <code>hooks.jsonl</code>) against the
            <a href={CONTRACT_URL}>coordination contract</a>. This is real: <strong>{covCount("emitted")} emitted</strong> ·
            <strong>{covCount("in_note")} in note</strong> · <strong>{covCount("blind")} blind</strong> of {totalAttrs}.
          </p>
        </div>
        <div class="cov-legend">
          <span class="cov emitted"><span class="g mono">●</span> {COV_LABEL.emitted}</span>
          <span class="cov in_note"><span class="g mono">◐</span> {COV_LABEL.in_note}</span>
          <span class="cov blind"><span class="g mono">⊘</span> {COV_LABEL.blind}</span>
        </div>
        {COVERAGE.map((grp) => (
          <div class="cov-group">
            <h3 class="cov-group-h">{grp.group}</h3>
            <ul class="cov-list">
              {grp.attrs.map((a) => (
                <li class={`cov-row ${a.cov}`}>
                  <span class="g mono" aria-hidden="true" title={COV_LABEL[a.cov]}>{COV_GLYPH[a.cov]}</span>
                  <span class="cov-name mono">{a.name}</span>
                  {a.note && <span class="cov-note">{a.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <!-- L2 structure: coordination contexts (blind until the anchor is emitted) -->
      <section aria-labelledby="ctx-h">
        <div class="section-head">
          <h2 id="ctx-h" class="display">Coordination contexts</h2>
          <p class="hint">Each instance of coordination, anchored on <code>coordination_context_id</code>, drills down to its events. The anchor isn't emitted yet, so this is blind.</p>
        </div>
        <div class="blind-panel">
          <span class="g mono" aria-hidden="true">⊘</span>
          <p>
            <strong>Blind.</strong> No coordination contexts yet — <code>tapestry.coordination_context_id</code> is not emitted.
            Once the hooks carry the anchor, contexts appear here (fleet → project → context → event), each with its
            coordination-quality state.
          </p>
        </div>
      </section>

      <footer class="foot">
        <p class="mono">
          Canon: <a href={CANON_URL}>user-agent-coordination-reinforcement</a> · Contract:
          <a href={CONTRACT_URL}>otel-coordination-contract</a>. Coordination quality is correction frequency,
          friction recurrence, memory-miss rate, and time-to-durable-structure — not request rate or latency.
        </p>
      </footer>
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
        --surface: #0a0d0e; --surface-raised: #16191b; --edge: #2a2f31;
        --ink: #f3f5f4; --ink-dim: #c4ccca; --ink-faint: #8b9492;
        --font-display: "Instrument Serif", Georgia, serif;
        --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, Consolas, monospace;
        --brand: #5fd3da;
        --healthy: #8fa99b; --healthy-soft: #8fa99b14; --healthy-edge: #8fa99b40;
        --degraded: #d8b06a; --degraded-soft: #d8b06a16; --degraded-edge: #d8b06a40;
        --blind: #b98a8a; --blind-soft: #b98a8a14; --blind-edge: #b98a8a3a;
        --unknown: #8b9492; --unknown-soft: #2a2f3155;
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; }
      body {
        margin: 0; font-size: 16px; line-height: 1.55; color: var(--ink);
        font-family: var(--font-sans); -webkit-font-smoothing: antialiased;
        background: radial-gradient(120% 80% at 50% 120%, #5fd3da12 0%, transparent 60%), var(--surface);
        background-attachment: fixed;
      }
      a { color: inherit; }
      .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
      .display { font-family: var(--font-display); font-weight: 400; letter-spacing: 0.01em; }
      .display-accent { font-family: var(--font-display); font-style: italic; color: var(--brand); }

      .topbar { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; border-bottom: 1px solid var(--edge); position: sticky; top: 0; z-index: 10; background: #0a0d0ecc; backdrop-filter: blur(8px); }
      .wordmark { font-family: var(--font-display); font-size: 20px; text-decoration: none; }
      .topnav { display: flex; gap: 18px; font-size: 14px; }
      .topnav a { color: var(--ink-faint); text-decoration: none; padding: 4px 2px; }
      .topnav a:hover { color: var(--ink); }
      .topnav a.here { color: var(--ink); border-bottom: 2px solid var(--brand); }

      main { max-width: 1000px; margin: 0 auto; padding: 44px 24px 96px; }
      section { margin-bottom: 48px; }
      .hero { margin-bottom: 24px; }
      .eyebrow { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 6px; }
      .hero h1 { font-size: clamp(44px, 7vw, 70px); margin: 0 0 12px; line-height: 1.03; }
      .lede { font-size: 18px; color: var(--ink-dim); max-width: 66ch; margin: 0; }

      .states { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid var(--edge); border-radius: 14px; background: var(--surface-raised); }
      .st { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; }
      .st .g { font-size: 12px; }
      .st.healthy { color: var(--healthy); } .st.degraded { color: var(--degraded); }
      .st.blind { color: var(--blind); } .st.unknown { color: var(--ink-faint); }
      .states-note { flex-basis: 100%; margin: 4px 0 0; font-size: 13px; color: var(--ink-dim); }
      .states-note strong { color: var(--ink); }

      .section-head { margin: 0 0 16px; }
      .section-head h2 { font-size: 28px; margin: 0; }
      .hint { font-size: 14px; color: var(--ink-faint); margin: 5px 0 0; max-width: 78ch; }
      .hint a { color: var(--brand); text-decoration: none; } .hint a:hover { text-decoration: underline; }
      .hint strong { color: var(--ink-dim); }
      code { font-family: var(--font-mono); font-size: 0.86em; color: var(--ink-dim); background: var(--unknown-soft); padding: 1px 5px; border-radius: 5px; }

      .mech-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
      .mech { border: 1px solid var(--edge); border-left-width: 3px; border-radius: 14px; padding: 14px 16px; background: color-mix(in srgb, var(--surface-raised) 55%, transparent); }
      .mech.healthy { border-left-color: var(--healthy-edge); }
      .mech.degraded { border-left-color: var(--degraded-edge); }
      .mech.blind { border-left-color: var(--blind-edge); }
      .mech.unknown { border-left-color: var(--edge); }
      .mech-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
      .mech-name { font-size: 16px; font-weight: 600; }
      .mech-why { font-size: 13px; color: var(--ink-dim); margin: 7px 0 0; }
      .state-pill { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; white-space: nowrap; }
      .state-pill.healthy { color: var(--healthy); } .state-pill.degraded { color: var(--degraded); }
      .state-pill.blind { color: var(--blind); } .state-pill.unknown { color: var(--ink-faint); }

      .cov-legend { display: flex; flex-wrap: wrap; gap: 14px; margin: 0 0 16px; font-size: 12px; }
      .cov { display: inline-flex; align-items: center; gap: 6px; }
      .cov.emitted { color: var(--healthy); } .cov.in_note { color: var(--degraded); } .cov.blind { color: var(--blind); }
      .cov-group { margin-bottom: 16px; }
      .cov-group-h { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-faint); margin: 0 0 8px; }
      .cov-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; }
      .cov-row { display: flex; align-items: baseline; gap: 10px; padding: 6px 10px; border: 1px solid var(--edge); border-radius: 8px; background: var(--surface); }
      .cov-row.emitted { border-color: var(--healthy-edge); }
      .cov-row.in_note { border-color: var(--degraded-edge); }
      .cov-row.blind { border-style: dashed; }
      .cov-row .g { font-size: 11px; flex: none; }
      .cov-row.emitted .g { color: var(--healthy); } .cov-row.in_note .g { color: var(--degraded); } .cov-row.blind .g { color: var(--blind); }
      .cov-name { font-size: 12.5px; color: var(--ink-dim); }
      .cov-note { font-size: 11px; color: var(--ink-faint); margin-left: auto; text-align: right; }

      .blind-panel { display: flex; gap: 12px; align-items: flex-start; padding: 18px; border: 1px dashed var(--blind-edge); border-radius: 14px; background: var(--blind-soft); }
      .blind-panel .g { font-size: 18px; color: var(--blind); }
      .blind-panel p { margin: 0; font-size: 14px; color: var(--ink-dim); }
      .blind-panel strong { color: var(--ink); }

      .foot { margin-top: 8px; }
      .foot p { font-size: 12px; color: var(--ink-faint); max-width: 86ch; }
      .foot a { color: var(--ink-dim); }

      @media (max-width: 720px) { .mech-grid { grid-template-columns: 1fr; } .cov-note { display: none; } .hero h1 { font-size: 44px; } }
      @media (prefers-reduced-motion: reduce) { * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }
    </style>
  </body>
</html>
