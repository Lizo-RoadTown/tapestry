---
export const prerender = false;
/**
 * The Observatory — what the telemetry EXPLAINS, not the telemetry itself.
 * Four meaning views: project-shape timeline (narrative), the observer speaking
 * (by confidence), the project-shape map (states + movement), and friction over
 * time. Counters are evidence, not the story — they live in /observatory/raw.
 * Honest: where the observer can't speak yet, it says so. Nothing faked.
 */
const CANON = "https://github.com/Lizo-RoadTown/tapestry/blob/main/docs/canon/user-agent-coordination-reinforcement.md";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Observatory — Tapestry</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href="/">Tapestry</a>
      <nav class="topnav"><a href="/">Docs</a><a class="here" href="/observatory">Observatory</a><a href="/observatory/raw">Raw events</a></nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow mono" id="src">project observatory · loading…</p>
        <h1 class="display">Project <span class="ac">Observatory</span></h1>
        <p class="lede">How the project is changing, what the observer sees, and whether coordination between you and your agents is getting better or worse.</p>
      </section>

      <!-- View 1: Project shape timeline (narrative) -->
      <section>
        <h2 class="display sec">How the project is changing</h2>
        <div id="timeline" class="timeline"><p class="loading mono">loading…</p></div>
      </section>

      <!-- View 3: Observer feed (the observer speaks) -->
      <section>
        <h2 class="display sec">What the observer sees</h2>
        <p class="hint">The observer, speaking — grouped by how sure it is.</p>
        <div id="observer" class="obs"><p class="loading mono">loading…</p></div>
      </section>

      <!-- View 4: Project shape map (states + movement) -->
      <section>
        <h2 class="display sec">Project shape</h2>
        <p class="hint">Where each part of the system stands.</p>
        <div id="shapemap" class="shapemap"><p class="loading mono">loading…</p></div>
      </section>

      <!-- View 2: Friction over time -->
      <section>
        <h2 class="display sec">Is coordination getting better or worse?</h2>
        <div id="friction" class="friction"><p class="loading mono">loading…</p></div>
      </section>

      <footer class="foot"><p class="mono">Raw counters + hook events: <a href="/observatory/raw">Raw events (debug)</a>. Canon: <a href={CANON}>user-agent-coordination-reinforcement</a>.</p></footer>
    </main>

    <script>
      const esc = (s: any) => String(s).replace(/[&<>]/g, (c: string) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]!));
      const day = (iso: string | null) => (iso ? new Date(iso).toLocaleString(undefined, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) : "");

      async function load() {
        const d = await (await fetch("/api/episodes.json", { cache: "no-store" })).json();
        const sl: Record<string, string> = { "live:central-store": "live", "dev:hooks.jsonl": "live · this machine", "snapshot:events-sample": "real snapshot (wire the hooks for live)" };
        (document.getElementById("src") as HTMLElement).textContent = "project observatory · " + (sl[d.source] || d.source);

        // View 1 — timeline
        const tl = d.timeline;
        (document.getElementById("timeline") as HTMLElement).innerHTML = tl.length
          ? tl.map((e: any) => `<div class="tl"><div class="tl-dot ${e.kind}"></div><div class="tl-body"><div class="tl-when mono">${esc(day(e.ts))}</div><div class="tl-title">${esc(e.title)}</div><ul class="tl-detail">${e.detail.map((x: string) => `<li>${esc(x)}</li>`).join("")}</ul></div></div>`).join("")
          : '<div class="tl"><div class="tl-dot stable"></div><div class="tl-body"><div class="tl-title">Architecture has been stable</div><p class="muted">No shape changes in the captured window. Evolution events appear here as the project moves.</p></div></div>';

        // View 3 — observer feed
        const obs = d.observer;
        const groups: Array<["high" | "medium" | "low", string]> = [["high", "High confidence"], ["medium", "Medium confidence"], ["low", "Low confidence"]];
        (document.getElementById("observer") as HTMLElement).innerHTML = groups.map(([c, lab]) => {
          const items = obs.filter((o: any) => o.confidence === c);
          if (!items.length) return "";
          return `<div class="ogrp ${c}"><div class="ohead"><span class="dot"></span>${lab}</div>${items.map((o: any) => `<div class="ob"><p class="ot">${esc(o.text)}</p><p class="obasis mono">${esc(o.basis)}</p></div>`).join("")}</div>`;
        }).join("");

        // View 4 — shape map
        const sm = d.shapeMap;
        (document.getElementById("shapemap") as HTMLElement).innerHTML = sm.map((m: any) => `<div class="mech ${m.state}"><div class="mtop"><span class="mname">${esc(m.name)}</span><span class="mstate">${esc(m.state)}</span></div><p class="mnote">${esc(m.note)}</p></div>`).join("");

        // View 2 — friction
        const f = d.friction; const fh = document.getElementById("friction") as HTMLElement;
        if (!f.instrumented) {
          fh.innerHTML = `<div class="fchart blind"><svg viewBox="0 0 600 160" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="80" x2="600" y2="80" stroke="#2a2f31" stroke-dasharray="5 6"/></svg><div class="foverlay"><span class="g mono">⊘</span><p>${esc(f.note)}</p></div></div>`;
        } else {
          fh.innerHTML = "<p class='loading mono'>chart</p>";
        }
      }
      load().catch((e) => { (document.getElementById("timeline") as HTMLElement).innerHTML = '<p class="loading mono">feed error: ' + esc(e) + "</p>"; });
    </script>

    <style is:global>
      :root{color-scheme:dark;--surface:#0a0d0e;--raised:#16191b;--edge:#2a2f31;--ink:#f3f5f4;--dim:#c4ccca;--faint:#8b9492;--brand:#5fd3da;--ok:#8fa99b;--warn:#d8b06a;--lineage:#9d92c4;--font-d:"Instrument Serif",Georgia,serif;--font-s:"Inter",system-ui,sans-serif;--font-m:"JetBrains Mono",ui-monospace,Consolas,monospace}
      *{box-sizing:border-box}html,body{height:100%}
      body{margin:0;font:16px/1.55 var(--font-s);color:var(--ink);background:radial-gradient(120% 80% at 50% 120%,#5fd3da12 0,transparent 60%),var(--surface);background-attachment:fixed;-webkit-font-smoothing:antialiased}
      a{color:inherit}.mono{font-family:var(--font-m);font-variant-numeric:tabular-nums}.display{font-family:var(--font-d);font-weight:400}.ac{font-family:var(--font-d);font-style:italic;color:var(--brand)}
      .topbar{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid var(--edge);position:sticky;top:0;z-index:10;background:#0a0d0ecc;backdrop-filter:blur(8px)}
      .wordmark{font-family:var(--font-d);font-size:20px;text-decoration:none}.topnav{display:flex;gap:18px;font-size:14px}.topnav a{color:var(--faint);text-decoration:none}.topnav a:hover{color:var(--ink)}.topnav .here{color:var(--ink);border-bottom:2px solid var(--brand)}
      main{max-width:860px;margin:0 auto;padding:42px 24px 90px}section{margin-bottom:48px}
      .eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);margin:0 0 6px}
      .hero h1{font-size:clamp(40px,7vw,62px);margin:0 0 10px;line-height:1.03}.lede{font-size:18px;color:var(--dim);max-width:60ch;margin:0}
      .sec{font-size:27px;margin:0 0 6px}.hint{font-size:13.5px;color:var(--faint);margin:0 0 18px}.muted{color:var(--faint);font-size:13px;margin:4px 0 0}.loading{color:var(--faint);font-size:13px}
      /* timeline */
      .timeline{position:relative}
      .tl{display:flex;gap:16px;padding:0 0 22px;position:relative}
      .tl::before{content:"";position:absolute;left:6px;top:16px;bottom:-6px;width:2px;background:var(--edge)}.tl:last-child::before{display:none}
      .tl-dot{width:14px;height:14px;border-radius:50%;margin-top:3px;flex:none;background:var(--brand);box-shadow:0 0 0 4px #5fd3da1a}
      .tl-dot.stable{background:var(--faint);box-shadow:none}
      .tl-when{font-size:12px;color:var(--faint)}.tl-title{font-size:16px;font-weight:600;margin:2px 0 0}
      .tl-detail{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:4px}.tl-detail li{font-size:13.5px;color:var(--dim);font-family:var(--font-m);font-size:12.5px;border-left:2px solid var(--edge);padding-left:10px}
      /* observer feed */
      .obs{display:grid;gap:16px}
      .ogrp{border:1px solid var(--edge);border-radius:14px;padding:16px;background:color-mix(in srgb,var(--raised) 50%,transparent)}
      .ohead{display:flex;align-items:center;gap:8px;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--faint);margin-bottom:12px}
      .ohead .dot{width:8px;height:8px;border-radius:50%}
      .ogrp.high{border-left:3px solid var(--warn)}.ogrp.high .dot{background:var(--warn)}
      .ogrp.medium{border-left:3px solid var(--brand)}.ogrp.medium .dot{background:var(--brand)}
      .ogrp.low{border-left:3px solid var(--faint)}.ogrp.low .dot{background:var(--faint)}
      .ob{padding:10px 0;border-top:1px solid #2a2f3144}.ob:first-of-type{border-top:none;padding-top:0}
      .ot{margin:0;font-size:15px;color:var(--ink);line-height:1.5}.obasis{margin:6px 0 0;font-size:11px;color:var(--faint)}
      /* shape map */
      .shapemap{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
      .mech{border:1px solid var(--edge);border-radius:12px;padding:13px 14px;background:color-mix(in srgb,var(--raised) 50%,transparent);border-top-width:3px}
      .mech.changing{border-top-color:var(--brand)}.mech.active{border-top-color:var(--ok)}.mech.emerging{border-top-color:var(--lineage)}.mech.stable{border-top-color:var(--faint)}.mech.blind{border-top-color:var(--edge)}
      .mtop{display:flex;align-items:baseline;justify-content:space-between;gap:8px}.mname{font-size:15px;font-weight:600}
      .mstate{font-size:11px;text-transform:uppercase;letter-spacing:.05em}
      .mech.changing .mstate{color:var(--brand)}.mech.active .mstate{color:var(--ok)}.mech.emerging .mstate{color:var(--lineage)}.mech.stable .mstate,.mech.blind .mstate{color:var(--faint)}
      .mnote{margin:7px 0 0;font-size:12px;color:var(--faint)}
      /* friction */
      .friction .fchart{position:relative;border:1px solid var(--edge);border-radius:14px;height:160px;background:color-mix(in srgb,var(--raised) 40%,transparent);overflow:hidden}
      .fchart.blind{border-style:dashed}.fchart svg{width:100%;height:100%;display:block;opacity:.5}
      .foverlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:0 30px;text-align:center}
      .foverlay .g{font-size:20px;color:var(--faint)}.foverlay p{margin:0;font-size:13px;color:var(--dim);max-width:60ch}
      .foot{margin-top:24px}.foot p{font-size:12px;color:var(--faint)}.foot a{color:var(--dim)}
      @media(max-width:680px){.shapemap{grid-template-columns:1fr 1fr}}
    </style>
  </body>
</html>
