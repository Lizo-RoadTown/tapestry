---
export const prerender = false;
/**
 * The Observatory — the coordination console.
 *
 * Reads the live episode feed (/api/episodes.json) and renders coordination
 * EPISODES — one operator-agent working cycle each — not raw event counts.
 * Per docs/reference/coordination-episode-model.md + the canon.
 *
 * The feed is wired to the hooks (central store when set, else this machine's
 * hooks.jsonl in dev, else a real bundled snapshot). The interpretation runs
 * server-side; this page renders it. Honest: intent is uncertain and
 * memory/friction are blind until the observer/contract land — shown, not faked.
 */
const CANON = "https://github.com/Lizo-RoadTown/tapestry/blob/main/docs/canon/user-agent-coordination-reinforcement.md";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Observatory — Tapestry</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href="/">Tapestry</a>
      <nav class="topnav"><a href="/">Docs</a><a class="here" href="/observatory">Observatory</a></nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow mono" id="src">coordination console · loading…</p>
        <h1 class="display">The <span class="ac">Observatory</span></h1>
        <p class="lede">Each line is a <strong>working episode</strong> — one cycle of you and an agent working together. Not event counts.</p>
      </section>

      <section class="summary" id="summary" aria-live="polite"></section>

      <section class="meaning-note" id="meaning">
        <span class="g mono">○</span>
        <p>Intent is <strong>not yet observer-derived</strong> (shown as the coarse prompt category, marked uncertain). <strong>Memory</strong> and <strong>friction</strong> are blind until instrumented. These get real as the observer + contract land — they are shown here, never faked.</p>
      </section>

      <section><h2 class="display sec">Working episodes</h2><div id="episodes" class="episodes"><p class="loading mono">loading episodes…</p></div></section>

      <footer class="foot"><p class="mono">Episodes built from real hook telemetry via the coordination episode model. Canon: <a href={CANON}>user-agent-coordination-reinforcement</a>.</p></footer>
    </main>

    <script>
      type Ep = {
        session: string; project: string; start: string | null; end: string | null;
        durationMs: number | null; intent: string; intentCertain: boolean;
        tools: { name: string; count: number }[]; toolCalls: number;
        snapshot: string | null; durableCandidates: number; verdict: string;
      };
      const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]!));
      const ago = (iso: string | null) => {
        if (!iso) return "";
        const s = Math.floor((Date.now() - Date.parse(iso)) / 1000);
        if (s < 60) return s + "s ago";
        if (s < 3600) return Math.floor(s / 60) + "m ago";
        if (s < 86400) return Math.floor(s / 3600) + "h ago";
        return Math.floor(s / 86400) + "d ago";
      };
      const dur = (ms: number | null) => (ms == null ? "" : ms < 1000 ? ms + "ms" : Math.round(ms / 1000) + "s");

      async function load() {
        const r = await fetch("/api/episodes.json", { cache: "no-store" });
        const d = await r.json();
        const srcLabel: Record<string, string> = {
          "live:central-store": "live · central store",
          "dev:hooks.jsonl": "live · this machine's hooks",
          "snapshot:events-sample": "real snapshot (wire the hooks for live)",
        };
        (document.getElementById("src") as HTMLElement).textContent = "coordination console · " + (srcLabel[d.source] || d.source);

        const s = d.summary;
        (document.getElementById("summary") as HTMLElement).innerHTML = [
          ["episodes", s.episodes], ["sessions", s.sessions], ["projects", s.projects],
          ["produced durable structure", s.withDurable], ["tool calls", s.toolCalls],
        ].map(([k, v]) => `<div class="stat"><span class="num mono">${v}</span><span class="lab">${k}</span></div>`).join("")
          + `<div class="stat blind"><span class="num mono">${s.episodes}</span><span class="lab">intent uncertain · memory + friction blind</span></div>`;

        const eps: Ep[] = d.episodes;
        const host = document.getElementById("episodes") as HTMLElement;
        if (!eps.length) { host.innerHTML = '<p class="loading mono">no episodes yet</p>'; return; }
        host.innerHTML = eps.slice(0, 60).map((e) => {
          const tools = e.tools.length ? e.tools.map((t) => `${esc(t.name)}${t.count > 1 ? "·" + t.count : ""}`).join("  ") : "—";
          const verdict = e.verdict === "strengthened"
            ? '<span class="v ok">● strengthened</span>'
            : '<span class="v unk">○ can\'t assess yet</span>';
          const meta = [
            e.snapshot ? `shape: snapshot` : "",
            e.durableCandidates ? `${e.durableCandidates} durable candidate${e.durableCandidates > 1 ? "s" : ""}` : "",
          ].filter(Boolean).join("  ·  ");
          return `<article class="ep">
            <div class="ep-top">
              <span class="intent">${esc(e.intent)} <span class="unc" title="not observer-derived yet">intent unclear</span></span>
              <span class="when mono">${ago(e.start)}${e.durationMs != null ? " · " + dur(e.durationMs) : ""}</span>
            </div>
            <div class="did"><span class="k">agent did</span> <span class="mono">${tools}</span> <span class="tc mono">${e.toolCalls} call${e.toolCalls === 1 ? "" : "s"}</span></div>
            ${meta ? `<div class="extra mono">${meta}</div>` : ""}
            <div class="ep-foot"><span class="proj mono">${esc(e.project)} · ${esc(e.session)}</span><span class="blindset mono">memory ⊘ · friction ⊘</span>${verdict}</div>
          </article>`;
        }).join("");
      }
      load().catch((e) => { (document.getElementById("episodes") as HTMLElement).innerHTML = '<p class="loading mono">feed error: ' + esc(String(e)) + "</p>"; });
    </script>

    <style is:global>
      :root{color-scheme:dark;--surface:#0a0d0e;--raised:#16191b;--edge:#2a2f31;--ink:#f3f5f4;--dim:#c4ccca;--faint:#8b9492;--brand:#5fd3da;--ok:#8fa99b;--warn:#d8b06a;--font-d:"Instrument Serif",Georgia,serif;--font-s:"Inter",system-ui,sans-serif;--font-m:"JetBrains Mono",ui-monospace,Consolas,monospace}
      *{box-sizing:border-box}html,body{height:100%}
      body{margin:0;font:16px/1.55 var(--font-s);color:var(--ink);background:radial-gradient(120% 80% at 50% 120%,#5fd3da12 0,transparent 60%),var(--surface);background-attachment:fixed;-webkit-font-smoothing:antialiased}
      a{color:inherit}.mono{font-family:var(--font-m);font-variant-numeric:tabular-nums}.display{font-family:var(--font-d);font-weight:400}.ac{font-family:var(--font-d);font-style:italic;color:var(--brand)}
      .topbar{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid var(--edge);position:sticky;top:0;z-index:10;background:#0a0d0ecc;backdrop-filter:blur(8px)}
      .wordmark{font-family:var(--font-d);font-size:20px;text-decoration:none}.topnav{display:flex;gap:18px;font-size:14px}.topnav a{color:var(--faint);text-decoration:none}.topnav a:hover{color:var(--ink)}.topnav .here{color:var(--ink);border-bottom:2px solid var(--brand)}
      main{max-width:920px;margin:0 auto;padding:40px 24px 90px}
      .eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);margin:0 0 6px}
      .hero h1{font-size:clamp(40px,7vw,64px);margin:0 0 10px;line-height:1.03}.lede{font-size:18px;color:var(--dim);max-width:60ch;margin:0}.lede strong{color:var(--ink);font-weight:500}
      .summary{display:flex;flex-wrap:wrap;gap:10px;margin:28px 0}
      .stat{flex:1 1 120px;border:1px solid var(--edge);border-radius:12px;padding:12px 14px;background:color-mix(in srgb,var(--raised) 55%,transparent);display:flex;flex-direction:column;gap:3px}
      .stat .num{font-size:24px;font-weight:600}.stat .lab{font-size:11px;color:var(--faint);text-transform:uppercase;letter-spacing:.05em}
      .stat.blind{flex-basis:100%;border-style:dashed}.stat.blind .num{color:var(--faint)}
      .meaning-note{display:flex;gap:12px;align-items:flex-start;margin:0 0 32px;padding:13px 15px;border:1px solid var(--edge);border-radius:13px;background:var(--raised)}
      .meaning-note .g{color:var(--faint);font-size:16px}.meaning-note p{margin:0;font-size:13.5px;color:var(--dim)}.meaning-note strong{color:var(--ink)}
      .sec{font-size:24px;margin:0 0 14px}
      .episodes{display:grid;gap:10px}.loading{color:var(--faint);font-size:13px}
      .ep{border:1px solid var(--edge);border-radius:13px;padding:14px 16px;background:color-mix(in srgb,var(--raised) 50%,transparent)}
      .ep-top{display:flex;justify-content:space-between;gap:12px;align-items:baseline}
      .intent{font-size:15px;font-weight:500}.unc{font-size:10px;color:var(--warn);border:1px solid #d8b06a40;border-radius:6px;padding:1px 5px;margin-left:6px;font-weight:400}
      .when{font-size:12px;color:var(--faint);white-space:nowrap}
      .did{margin-top:8px;font-size:13px;color:var(--dim)}.did .k{color:var(--faint);font-size:11px;text-transform:uppercase;letter-spacing:.05em;margin-right:6px}.did .tc{color:var(--faint);font-size:11px;margin-left:6px}
      .extra{margin-top:6px;font-size:12px;color:var(--faint)}
      .ep-foot{margin-top:11px;padding-top:10px;border-top:1px solid var(--edge);display:flex;flex-wrap:wrap;gap:10px;align-items:center;font-size:11px}
      .proj{color:var(--faint)}.blindset{color:var(--faint);margin-left:auto}
      .v{font-size:11px;padding:2px 8px;border-radius:999px;border:1px solid var(--edge)}.v.ok{color:var(--ok);border-color:#8fa99b40}.v.unk{color:var(--faint)}
      .foot{margin-top:30px}.foot p{font-size:12px;color:var(--faint)}.foot a{color:var(--dim)}
      @media(max-width:680px){.blindset{margin-left:0}}
    </style>
  </body>
</html>
