---
/**
 * Why projects compound.
 *
 * Reframed 2026-06-25: the "project shape" concept was dropped as inaccurate.
 * The accurate message: an agent doesn't improve on its own between model
 * releases; Tapestry watches across all your projects and turns recurring
 * friction into durable structure, so the work keeps improving anyway. Lead
 * with that, not a label. The route stays /project-shape for stable links.
 */
import SiteLayout from "../layouts/SiteLayout.astro";

const CONCEPT = "/start/what-stays-on-track/";
const OBSERVATORY = "/observatory";

// What recurring friction looks like.
const PATTERNS = [
  "a correction you keep repeating",
  "a workflow you redo by hand every time",
  "a mistake that keeps coming back",
  "context you re-explain every session",
  "a decision the agent forgets",
  "a fix that doesn't stick",
];

// What the accumulated structure makes possible.
const OUTCOMES = [
  "the same correction stops coming back",
  "repeated work becomes a reusable skill",
  "decisions survive between sessions",
  "improvements carry across all your projects",
  "a new model doesn't reset what you've built",
];

// What recurring friction turns into.
const MOTIONS = [
  { title: "Corrections become rules", body: "A fix you make once is captured as a rule the agent keeps. The same drift stops needing the same correction.", glyph: `<path d="M20 6 9 17l-5-5"/>` },
  { title: "Repeated work becomes skills", body: "Work you do the same way again and again compiles into a named skill, available in every project by reference.", glyph: `<path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M2 14l10 5 10-5"/><path d="M2 11l10 5 10-5"/>` },
  { title: "Decisions become memory", body: "What you decided and why is kept and recalled, instead of re-explained from scratch each session.", glyph: `<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>` },
  { title: "Patterns become structure", body: "Friction that recurs across projects is surfaced and turned into durable structure you reuse everywhere.", glyph: `<circle cx="4" cy="5" r="1.6"/><circle cx="4" cy="12" r="1.6"/><circle cx="4" cy="19" r="1.6"/><path d="M6 5.5 17 11M6 12h9M6 18.5 17 13" opacity="0.5"/><circle cx="19" cy="12" r="2.6" fill="currentColor" stroke="none"/>` },
];
---

<SiteLayout title="Why projects compound — Tapestry" description="An AI agent is fixed until the next model ships — on its own it makes the same mistakes next week. Tapestry watches across all your projects and turns recurring friction into durable structure, so the work keeps getting better even though the agent stays the same." activeNav="learn">
  <!-- hero: the insight, in plain language -->
  <section class="ps-hero">
    <div class="ps-glow" aria-hidden="true"></div>
    <div class="ps-hero-in reveal">
      <h1 class="display">Your agent doesn't improve.<br /><span class="accent">Your projects do.</span></h1>
      <p class="ps-para">An AI agent is fixed until the next model ships. On its own, it makes the same mistakes next week that it makes today — and when a new model does arrive, it can behave differently enough that you have to recalibrate.</p>
      <p class="ps-para">Tapestry watches across all your projects and turns recurring friction into structure — so the work keeps getting better even though the agent stays the same.</p>
      <div class="cta-row">
        <a class="btn btn-lg" href={CONCEPT}>What Tapestry is →</a>
        <a class="btn btn-ghost btn-lg" href={OBSERVATORY}>Watch it work →</a>
      </div>
    </div>
  </section>

  <!-- name the mechanism -->
  <section class="ps-name">
    <div class="ps-name-in">
      <p class="ps-lead reveal">
        Every project hits the same kinds of friction — a correction repeated, a workflow redone, context re-explained.
        <span class="ps-strong">Tapestry captures it once and turns it into structure the agent reuses.</span>
      </p>
      <ul class="ps-patterns reveal">
        {PATTERNS.map((p) => (<li><span class="tick" aria-hidden="true">→</span>{p}</li>))}
      </ul>
      <p class="ps-because reveal">Because solving the same problem twice is where projects quietly lose their momentum.</p>
    </div>
  </section>

  <!-- why it matters -->
  <section class="ps-why">
    <div class="ps-why-in reveal">
      <p class="kicker mono">Why it matters</p>
      <h2 class="display sec-title">Same agent.<br /><span class="accent">Better every week.</span></h2>
      <p class="ps-why-body">An agent doesn't learn between releases. The improvement in your work can't come from the agent alone — it comes from what accumulates around it: the corrections, decisions, and patterns captured as structure. That structure survives a model change instead of resetting with it.</p>
      <p class="ps-why-sub">That's what makes sure:</p>
      <ul class="ps-outcomes">
        {OUTCOMES.map((o) => (<li><span class="tick" aria-hidden="true">→</span>{o}</li>))}
      </ul>
      <p class="ps-why-close">Tapestry builds that structure automatically.</p>
    </div>
  </section>

  <!-- what friction becomes -->
  <section class="ps-motions">
    <header class="sec-head">
      <p class="kicker mono">What becomes structure</p>
      <h2 class="display sec-title">Friction goes in. Structure comes out.</h2>
      <p class="sec-sub">The recurring friction in your work gets captured in a form the agent reuses — automatically.</p>
    </header>
    <div class="ps-motion-grid">
      {MOTIONS.map((m) => (
        <article class="ps-motion reveal">
          <span class="ps-motion-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={m.glyph} /></span>
          <h3 class="ps-motion-name display">{m.title}</h3>
          <p class="ps-motion-body">{m.body}</p>
        </article>
      ))}
    </div>
    <p class="ps-motion-foot reveal">The observer watches for what recurs, so it becomes structure before it becomes a recurring cost.</p>
  </section>

  <!-- cta -->
  <section class="ps-cta">
    <div class="ps-cta-glow" aria-hidden="true"></div>
    <div class="reveal">
      <h2 class="display ps-cta-title">Stop solving the same<br /><span class="accent">problem twice.</span></h2>
      <div class="cta-row center"><a class="btn btn-lg" href="/how-to/set-up-a-new-project/">Set up a project</a><a class="btn btn-ghost btn-lg" href={OBSERVATORY}>Open the Observatory →</a></div>
    </div>
  </section>
</SiteLayout>

<style>
  .ps-hero { position: relative; overflow: hidden; padding: clamp(72px, 12vw, 140px) 24px clamp(48px, 8vw, 80px); text-align: center; }
  .ps-glow { position: absolute; inset: -20% 0 auto 0; height: 680px; background: radial-gradient(58% 65% at 50% 0%, #5fd3da26 0, #5fd3da0d 38%, transparent 70%); pointer-events: none; }
  .ps-hero-in { position: relative; max-width: 800px; margin: 0 auto; }
  .ps-hero h1 { font-size: clamp(46px, 8vw, 84px); line-height: 1.03; margin: 0 0 26px; letter-spacing: -0.01em; }
  .ps-para { font-size: clamp(17px, 2.05vw, 20px); line-height: 1.6; color: var(--dim); max-width: 60ch; margin: 0 auto 16px; }
  .cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
  .cta-row.center { justify-content: center; }

  /* name it */
  .ps-name { border-top: 1px solid var(--edge-soft); padding: clamp(56px, 9vw, 96px) 24px; }
  .ps-name-in { max-width: 720px; margin: 0 auto; }
  .ps-lead { font-size: clamp(20px, 2.6vw, 27px); line-height: 1.5; color: var(--dim); margin: 0 0 26px; }
  .ps-strong { color: var(--ink); font-weight: 500; }
  .ps-patterns { list-style: none; padding: 0; margin: 0 0 26px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 28px; }
  .ps-patterns li, .ps-outcomes li { display: flex; gap: 11px; align-items: baseline; font-size: 16px; color: var(--dim); }
  .tick { color: var(--brand); font-family: var(--font-m); flex: none; }
  .ps-because { font-family: var(--font-d); font-size: clamp(19px, 2.3vw, 24px); line-height: 1.4; color: var(--ink); margin: 0; }

  /* why */
  .ps-why { border-top: 1px solid var(--edge-soft); padding: clamp(56px, 9vw, 104px) 24px; }
  .ps-why-in { max-width: 760px; margin: 0 auto; }
  .ps-why .sec-title { text-align: left; }
  .ps-why-body { font-size: clamp(17px, 2vw, 20px); line-height: 1.6; color: var(--dim); margin: 0 0 24px; }
  .ps-why-sub { font-size: 16px; color: var(--faint); margin: 0 0 14px; }
  .ps-outcomes { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 12px; }
  .ps-why-close { font-family: var(--font-d); font-size: clamp(20px, 2.4vw, 26px); color: var(--ink); margin: 0; }

  /* motions */
  .ps-motions { border-top: 1px solid var(--edge-soft); padding: clamp(56px, 9vw, 104px) 0; }
  .ps-motion-grid { max-width: var(--maxw); margin: 46px auto 0; padding: 0 24px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .ps-motion { padding: 30px 26px; border: 1px solid var(--edge); border-radius: 18px; background: linear-gradient(180deg, var(--raised), var(--surface-2)); transition: transform 0.25s var(--ease), border-color 0.25s, box-shadow 0.25s; }
  .ps-motion:hover { transform: translateY(-4px); border-color: #34474a; box-shadow: 0 24px 50px -28px #000, 0 0 0 1px #5fd3da22; }
  .ps-motion-ic { display: inline-flex; align-items: center; justify-content: center; width: 50px; height: 50px; border-radius: 13px; color: var(--brand); background: #5fd3da14; border: 1px solid #5fd3da33; margin-bottom: 18px; }
  .ps-motion-name { font-size: 25px; margin: 0 0 10px; }
  .ps-motion-body { font-size: 14.5px; line-height: 1.55; color: var(--dim); margin: 0; }
  .ps-motion-foot { max-width: var(--maxw); margin: 34px auto 0; padding: 0 24px; font-size: clamp(16px, 1.9vw, 19px); color: var(--faint); text-align: center; }

  /* cta */
  .ps-cta { position: relative; overflow: hidden; text-align: center; padding: clamp(80px, 13vw, 150px) 24px; border-top: 1px solid var(--edge-soft); }
  .ps-cta-glow { position: absolute; inset: auto 0 -40% 0; height: 540px; background: radial-gradient(55% 70% at 50% 100%, #5fd3da22 0, transparent 70%); pointer-events: none; }
  .ps-cta-title { position: relative; font-size: clamp(32px, 5.5vw, 62px); line-height: 1.08; margin: 0 0 34px; }

  @media (max-width: 980px) {
    .ps-motion-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .ps-motion-grid { grid-template-columns: 1fr; }
    .ps-patterns { grid-template-columns: 1fr; }
  }
</style>
