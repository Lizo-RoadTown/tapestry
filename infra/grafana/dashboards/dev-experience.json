{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/public/api/dashboard-jsonschema.json",
  "uid": "dev-experience",
  "title": "Dev Experience — Hook Activity",
  "tags": ["dev-experience", "claude-code", "make-skills-discipline"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Hook events over time",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (hook) (count_over_time({job=\"claude-code-hooks\", phase=\"end\"} [$__interval]))",
          "legendFormat": "{{hook}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Action breakdown (last 24h)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (action) (count_over_time({job=\"claude-code-hooks\", phase=\"end\"} [24h]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },
    {
      "id": 3,
      "title": "Hook by name (last 24h)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (hook) (count_over_time({job=\"claude-code-hooks\", phase=\"end\"} [24h]))",
          "legendFormat": "{{hook}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },
    {
      "id": 4,
      "title": "Recent hook events",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"claude-code-hooks\", phase=\"end\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
