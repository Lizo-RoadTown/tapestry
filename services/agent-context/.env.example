# agent-context (loom-memory MCP) — environment.
# Copy to a real env in Render (or a local .env); NEVER commit real secret values.
# Only the variables the service code actually reads are listed.

# --- REQUIRED ---
# Postgres connection string (Render: use the INTERNAL url when the web service
# and DB are in the same Render account/region; faster, no egress).
LOOM_DB_URL=

# --- OPTIONAL (auth / hosted-multitenant) ---
# RS256 PEM public key used to VERIFY incoming Bearer JWTs (LoomTokenVerifier).
# Leave UNSET for a self-host smoke: with no Bearer, requests resolve to
# SELF_HOST_TENANT_ID. Set it (copy from loom-shared-secrets) to test the
# hosted-multitenant / auth path.
LOOM_JWT_PUBLIC_KEY=

# Self-host tenant UUID. Resolution order in code:
#   1. SELF_HOST_TENANT_ID (canonical, no prefix)
#   2. LOOM_SELF_HOST_TENANT_ID (deprecated alias; backward compat)
#   3. 00000000-0000-0000-0000-000000000000 (all-zeros placeholder default)
# For a real deployment set ONE value via env (e.g. generated with
# `python -c "import uuid; print(uuid.uuid4())"`) and use it consistently across
# every service in the same deployment — if it drifts, RLS returns empty results.
# SELF_HOST_TENANT_ID=

# Note: LOOM_JWT_PRIVATE_KEY (token issuing) is NOT read by this service's code —
# do not set it for staging.

# --- Render build ---
PYTHON_VERSION=3.12
