# Render Blueprint template for tapestry-docs-mcp.
#
# This is the EXAMPLE — rename to render.yaml in your deployment branch and
# adjust as needed. The platform owner deploys this manually; the service is
# not auto-deployed from main.
#
# After deployment:
#   1. Note the service URL (e.g., https://tapestry-docs-mcp.onrender.com)
#   2. Set MCP_PUBLIC_URL env var to that URL + /mcp
#   3. Set SITE_BASE_URL env var to https://tapestry-khaki.vercel.app
#   4. Update apps/docs-site/src/content/docs/systems/docs-mcp.md to remove the
#      caution banner and replace placeholder URLs with the real one
#   5. Add the MCP server entry to integrations/claude-code/tapestry-discipline/
#      .claude-plugin/plugin.json so consuming projects auto-discover it
services:
  - type: web
    name: tapestry-docs-mcp
    runtime: python
    plan: free
    rootDir: services/docs-mcp
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn main:app --host 0.0.0.0 --port $PORT
    healthCheckPath: /health
    envVars:
      - key: SITE_BASE_URL
        value: https://tapestry-khaki.vercel.app
      - key: MCP_PUBLIC_URL
        sync: false  # set in the Render dashboard after first deploy gives the URL
      - key: DOCS_ROOT
        value: ../../apps/docs-site/src/content/docs
